
/**
 * @flowWeaver nodeType
 * @expression
 * @input name [order:0] - Name
 * @output greeting [order:0] - Greeting
 */
function greet(name: string): { greeting: string } {
  return { greeting: `Hello, ${name}!` };
}

/**
 * @flowWeaver nodeType
 * @expression
 * @color teal
 * @icon ai
 * @input text [order:0] - Text
 * @output result [order:0] - Result
 */
function shout(text: string): { result: string } {
  return { result: text.toUpperCase() + '!!!' };
}

/**
 * @flowWeaver workflow
 * @node g greet [position: -216 -48]
 * @node s shout [position: 128 -48]
 * @path Start -> g -> s -> Exit
 * @position Start -544 -48
 * @position Exit 448 -48
 * @connect g.greeting -> s.text
 * @connect s.result -> Exit.message
 * @param execute [order:-1] - Execute
 * @param name [order:0] - Name
 * @returns onSuccess [order:-2] - On Success
 * @returns onFailure [order:-1] - On Failure
 * @returns message [order:0] - Message
 */
export async function helloWorld(
  execute: boolean,
  params: { name: string }
): Promise<{ onSuccess: boolean; onFailure: boolean; message: string }> {
  throw new Error('Not implemented');
}

/**
 * Generates chat response
 *
 * @flowWeaver nodeType
 * @expression
 * @label chat
 * @input history [order:0] - Conversation history
 * @input systemPrompt [order:1] - System prompt
 * @output response [order:0] - Assistant response
 * @output responseMessage [order:1] - Response as LLMMessage
 */
declare function chat(): void;
