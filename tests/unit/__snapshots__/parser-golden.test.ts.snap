exports[`AnnotationParser golden (debt #4) > parse output is stable: use-cases/data-pipeline.ts 1`] = `
{
  "errors": [],
  "nodeTypes": [
    {
      "defaultConfig": undefined,
      "description": "Validates a contact record before CRM import.
Routes to onFailure if email format is invalid or name is too short.",
      "executeWhen": "CONJUNCTION",
      "functionName": "validateContact",
      "functionText": "/**
 * Validates a contact record before CRM import.
 * Routes to onFailure if email format is invalid or name is too short.
 *
 * @flowWeaver nodeType
 * @label Validate Contact
 * @input email [order:1] - Contact email address
 * @input name [order:2] - Contact full name
 * @output email [order:2] - Validated email (passed through on success)
 * @output name [order:3] - Validated name (passed through on success)
 * @output reason [order:4] - Rejection reason (populated on failure)
 */
function validateContact(
  execute: boolean,
  email: string,
  name: string
): { onSuccess: boolean; onFailure: boolean; email: string; name: string; reason: string } {
  if (!execute) return { onSuccess: false, onFailure: false, email: '', name: '', reason: '' };

  if (!email.includes('@')) {
    return { onSuccess: false, onFailure: true, email, name, reason: 'Invalid email: missing @' };
  }
  if (name.trim().length < 2) {
    return { onSuccess: false, onFailure: true, email, name, reason: 'Name too short (min 2 chars)' };
  }

  return { onSuccess: true, onFailure: false, email, name, reason: '' };
}",
      "hasFailurePort": true,
      "hasSuccessPort": true,
      "inputs": {
        "email": {
          "dataType": "STRING",
          "default": undefined,
          "expression": undefined,
          "label": "Contact email address",
          "metadata": {
            "order": 1,
          },
          "optional": undefined,
          "tsType": "string",
        },
        "execute": {
          "dataType": "STEP",
          "label": "Execute",
          "metadata": {
            "order": -1,
          },
        },
        "name": {
          "dataType": "STRING",
          "default": undefined,
          "expression": undefined,
          "label": "Contact full name",
          "metadata": {
            "order": 2,
          },
          "optional": undefined,
          "tsType": "string",
        },
      },
      "isAsync": false,
      "label": "Validate Contact",
      "name": "validateContact",
      "outputs": {
        "email": {
          "dataType": "STRING",
          "label": "Validated email (passed through on success)",
          "metadata": {
            "order": 2,
          },
          "tsType": "string",
        },
        "name": {
          "dataType": "STRING",
          "label": "Validated name (passed through on success)",
          "metadata": {
            "order": 3,
          },
          "tsType": "string",
        },
        "onFailure": {
          "dataType": "STEP",
          "failure": true,
          "isControlFlow": true,
