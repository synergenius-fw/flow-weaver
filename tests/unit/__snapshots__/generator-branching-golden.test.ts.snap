  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'subWf', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'subWf',
      id: 'b',
      executionIndex: bIdx,
