// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`branching codegen golden (debt #2) > dev-mode output is stable: async-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (brAsync) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'brAsync', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brAsync',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'brAsync', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'brAsync', durable: false }, b_value);
      const bResult = await brAsync(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brAsync',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'brAsync', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brAsync',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brAsync',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'brAsync' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: async-map-iterator-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let mbIdx: number | undefined;
  let mhIdx: number | undefined;
  let mb_success = false;

  await __ctrl__.beforeNode('mb', ctx);

  // ── mb (asyncMapBranch) ──
  ctx.checkAborted('mb');
  mbIdx = ctx.addExecution('mb');
  if (ctx.shouldExecute('mb', 'asyncMapBranch', mbIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'asyncMapBranch',
      id: 'mb',
      executionIndex: mbIdx,
      status: 'RUNNING',
    });

    mb_success = false;

    try {
      const mb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'mb', portName: 'execute', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch', durable: false }, mb_execute);
      const mb_items = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as unknown[];
      await ctx.setVariable({ id: 'mb', portName: 'items', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch', durable: false }, mb_items);
      const mb_body_scopeFn = ((ctx) => {
      return async (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('mb', mbIdx!, 'body', true);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('mb_param_item');
        await scopedCtx.setVariable({ id: 'mb', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'asyncMapBranch', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('mb_scope_exit');
        return {  };
      };
    })(ctx);
      let mbResult: { onSuccess: boolean; onFailure: boolean; results: unknown[] };
      if (!mb_execute) {
        mbResult = { onSuccess: false, onFailure: false, results: [] };
      } else {
        const __results: unknown[] = [];
        for (const __item of mb_items) {
          __results.push((await mb_body_scopeFn(true, __item)).processed);
        }
        mbResult = { onSuccess: true, onFailure: false, results: __results };
      }
      await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.onSuccess);
      await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.onFailure);
      await ctx.setVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.results);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('mb', 'asyncMapBranch', mbIdx);
      await __ctrl__.afterNode('mb', ctx);
      mb_success = mbResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'asyncMapBranch',
          id: 'mb',
          executionIndex: mbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, false);
        await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, true);
        mb_success = false;
      }
      const mhIdx = ctx.addExecution('mh');
      await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
      await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    mb_success = await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as boolean;
  }

  if (mb_success) {
    ctx.enterBranch('mb', mbIdx, 'success');
    await __ctrl__.beforeNode('mh', ctx);
    ctx.checkAborted('mh');
    mhIdx = ctx.addExecution('mh');
    if (ctx.shouldExecute('mh', 'asyncMapSink', mhIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'RUNNING',
      });
      try {
        const mh_execute = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as boolean : false;
        await ctx.setVariable({ id: 'mh', portName: 'execute', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink', durable: false }, mh_execute);
        const mh_value = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as number : undefined;
        await ctx.setVariable({ id: 'mh', portName: 'value', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink', durable: false }, mh_value);
        const mhResult = asyncMapSink(mh_execute, mh_value);
        await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.onSuccess);
        await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.onFailure);
        await ctx.setVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'asyncMapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('mh', 'asyncMapSink', mhIdx);
        await __ctrl__.afterNode('mh', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'asyncMapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'asyncMapSink',
            id: 'mh',
            executionIndex: mhIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('mb', mbIdx, 'failure');
    const mhIdx = ctx.addExecution('mh');
    await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
    await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'asyncMapSink',
      id: 'mh',
      executionIndex: mhIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = mhIdx !== undefined ? await ctx.getVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: chained-branches 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let aIdx: number | undefined;
  let bbIdx: number | undefined;
  let okIdx: number | undefined;
  let a_success = false;
  let bb_success = false;


  await __ctrl__.beforeNode('a', ctx);

  // ── a (brA) ──
  ctx.checkAborted('a');
  aIdx = ctx.addExecution('a');
  if (ctx.shouldExecute('a', 'brA', aIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brA',
      id: 'a',
      executionIndex: aIdx,
      status: 'RUNNING',
    });

    a_success = false;

    try {
      const a_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'a', portName: 'execute', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_execute);
      const a_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'a', portName: 'value', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_value);
      const aResult = brA(a_execute, a_value);
      await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onSuccess);
      await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onFailure);
      await ctx.setVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('a', 'brA', aIdx);
      await __ctrl__.afterNode('a', ctx);
      a_success = aResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brA',
          id: 'a',
          executionIndex: aIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, false);
        await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, true);
        a_success = false;
      }
      throw error;
    }
  } else {
    a_success = await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean;
  }

  if (a_success) {
    await __ctrl__.beforeNode('bb', ctx);

    // ── bb (brB) ──
    ctx.checkAborted('bb');
    bbIdx = ctx.addExecution('bb');
    if (ctx.shouldExecute('bb', 'brB', bbIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: 'RUNNING',
      });

      bb_success = false;

      try {
        const bb_execute = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean : false;
        await ctx.setVariable({ id: 'bb', portName: 'execute', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_execute);
        const bb_value = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }) as number : undefined;
        await ctx.setVariable({ id: 'bb', portName: 'value', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_value);
        const bbResult = brB(bb_execute, bb_value);
        await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onSuccess);
        await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onFailure);
        await ctx.setVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.result);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('bb', 'brB', bbIdx);
        await __ctrl__.afterNode('bb', ctx);
        bb_success = bbResult.onSuccess;
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'brB',
            id: 'bb',
            executionIndex: bbIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
          await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
          await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, true);
          bb_success = false;
        }
        const okIdx = ctx.addExecution('ok');
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'CANCELLED',
        });
        throw error;
      }
    } else {
      bb_success = await ctx.getVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }) as boolean;
    }

    if (bb_success) {
      ctx.enterBranch('bb', bbIdx, 'success');
      await __ctrl__.beforeNode('ok', ctx);
      ctx.checkAborted('ok');
      okIdx = ctx.addExecution('ok');
      if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'RUNNING',
        });
        try {
          const ok_execute = bbIdx !== undefined ? await ctx.getVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }) as boolean : false;
          await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
          const ok_value = bbIdx !== undefined ? await ctx.getVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }) as number : undefined;
          await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
          const okResult = okSink(ok_execute, ok_value);
          await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
          await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
          await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
          await ctx.sendStatusChangedEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            status: 'SUCCEEDED',
          });
          ctx.commitNode('ok', 'okSink', okIdx);
          await __ctrl__.afterNode('ok', ctx);
        } catch (error: unknown) {
          if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
          const isCancellation = CancellationError.isCancellationError(error);
          await ctx.sendStatusChangedEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            status: isCancellation ? 'CANCELLED' : 'FAILED',
          });
          if (!isCancellation) {
            ctx.sendLogErrorEvent({
              nodeTypeName: 'okSink',
              id: 'ok',
              executionIndex: okIdx,
              error: error instanceof Error ? error.message : String(error),
              code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
            });
          }
          throw error;
        }
      }
      ctx.exitBranch();
    } else {
      ctx.enterBranch('bb', bbIdx, 'failure');
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      ctx.exitBranch();
    }
  } else {
    const bbIdx = ctx.addExecution('bb');
    await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
    await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brB',
      id: 'bb',
      executionIndex: bbIdx,
      status: 'CANCELLED',
    });
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: expression-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let chkIdx: number | undefined;
  let hIdx: number | undefined;
  let chk_success = false;

  await __ctrl__.beforeNode('chk', ctx);

  // ── chk (checkValue) ──
  ctx.checkAborted('chk');
  chkIdx = ctx.addExecution('chk');
  if (ctx.shouldExecute('chk', 'checkValue', chkIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'checkValue',
      id: 'chk',
      executionIndex: chkIdx,
      status: 'RUNNING',
    });

    chk_success = false;

    try {
      await ctx.setVariable({ id: 'chk', portName: 'execute', executionIndex: chkIdx, nodeTypeName: 'checkValue', durable: false }, true);
      const chk_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'chk', portName: 'value', executionIndex: chkIdx, nodeTypeName: 'checkValue', durable: false }, chk_value);
      const chkResult = checkValue(chk_value);
      const chkResult_raw: unknown = chkResult;
      await ctx.setVariable({ id: 'chk', portName: 'result', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, typeof chkResult_raw === 'object' && chkResult_raw !== null && 'result' in chkResult_raw ? chkResult_raw.result : chkResult_raw);
      await ctx.setVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
      await ctx.setVariable({ id: 'chk', portName: 'onFailure', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'checkValue',
        id: 'chk',
        executionIndex: chkIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('chk', 'checkValue', chkIdx);
      await __ctrl__.afterNode('chk', ctx);
      chk_success = true;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'checkValue',
        id: 'chk',
        executionIndex: chkIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'checkValue',
          id: 'chk',
          executionIndex: chkIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, false);
        await ctx.setVariable({ id: 'chk', portName: 'onFailure', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
        chk_success = false;
      }
      const hIdx = ctx.addExecution('h');
      await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
      await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'handler',
        id: 'h',
        executionIndex: hIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    chk_success = await ctx.getVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }) as boolean;
  }

  if (chk_success) {
    ctx.enterBranch('chk', chkIdx, 'success');
    await __ctrl__.beforeNode('h', ctx);
    ctx.checkAborted('h');
    hIdx = ctx.addExecution('h');
    if (ctx.shouldExecute('h', 'handler', hIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'handler',
        id: 'h',
        executionIndex: hIdx,
        status: 'RUNNING',
      });
      try {
        const h_execute = chkIdx !== undefined ? await ctx.getVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }) as boolean : false;
        await ctx.setVariable({ id: 'h', portName: 'execute', executionIndex: hIdx, nodeTypeName: 'handler', durable: false }, h_execute);
        let h_value: number = undefined as unknown as number; // Required port 'value' has no connection
        await ctx.setVariable({ id: 'h', portName: 'value', executionIndex: hIdx, nodeTypeName: 'handler', durable: false }, h_value);
        const hResult = handler(h_execute, h_value);
        await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.onSuccess);
        await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.onFailure);
        await ctx.setVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'handler',
          id: 'h',
          executionIndex: hIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('h', 'handler', hIdx);
        await __ctrl__.afterNode('h', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'handler',
          id: 'h',
          executionIndex: hIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'handler',
            id: 'h',
            executionIndex: hIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('chk', chkIdx, 'failure');
    const hIdx = ctx.addExecution('h');
    await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
    await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'handler',
      id: 'h',
      executionIndex: hIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = hIdx !== undefined ? await ctx.getVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'handler' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: expression-branch-extra-ports 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let exIdx: number | undefined;
  let hIdx: number | undefined;
  let ex_success = false;

  await __ctrl__.beforeNode('ex', ctx);

  // ── ex (exprExtra) ──
  ctx.checkAborted('ex');
  exIdx = ctx.addExecution('ex');
  if (ctx.shouldExecute('ex', 'exprExtra', exIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'exprExtra',
      id: 'ex',
      executionIndex: exIdx,
      status: 'RUNNING',
    });

    ex_success = false;

    try {
      await ctx.setVariable({ id: 'ex', portName: 'execute', executionIndex: exIdx, nodeTypeName: 'exprExtra', durable: false }, true);
      const ex_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'ex', portName: 'value', executionIndex: exIdx, nodeTypeName: 'exprExtra', durable: false }, ex_value);
      const ex_body_scopeFn = ((ctx) => {
      return (scopedOut: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('ex', exIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_scopedOut = scopedCtx.addExecution('ex_param_scopedOut');
        scopedCtx.setVariable({ id: 'ex', portName: 'scopedOut', executionIndex: scopeParamIdx_scopedOut, nodeTypeName: 'exprExtra', scope: 'body', side: 'start' }, scopedOut);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('ex_scope_exit');
        return {  };
      };
    })(ctx);
      const exResult = exprExtra(ex_value, ex_body_scopeFn);
      await ctx.setVariable({ id: 'ex', portName: 'low', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, exResult.low);
      await ctx.setVariable({ id: 'ex', portName: 'high', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, exResult.high);
      await ctx.setVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, true);
      await ctx.setVariable({ id: 'ex', portName: 'onFailure', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtra',
        id: 'ex',
        executionIndex: exIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('ex', 'exprExtra', exIdx);
      await __ctrl__.afterNode('ex', ctx);
      ex_success = true;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtra',
        id: 'ex',
        executionIndex: exIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'exprExtra',
          id: 'ex',
          executionIndex: exIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, false);
        await ctx.setVariable({ id: 'ex', portName: 'onFailure', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, true);
        ex_success = false;
      }
      const hIdx = ctx.addExecution('h');
      await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
      await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtraSink',
        id: 'h',
        executionIndex: hIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    ex_success = await ctx.getVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }) as boolean;
  }

  if (ex_success) {
    ctx.enterBranch('ex', exIdx, 'success');
    await __ctrl__.beforeNode('h', ctx);
    ctx.checkAborted('h');
    hIdx = ctx.addExecution('h');
    if (ctx.shouldExecute('h', 'exprExtraSink', hIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtraSink',
        id: 'h',
        executionIndex: hIdx,
        status: 'RUNNING',
      });
      try {
        const h_execute = exIdx !== undefined ? await ctx.getVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }) as boolean : false;
        await ctx.setVariable({ id: 'h', portName: 'execute', executionIndex: hIdx, nodeTypeName: 'exprExtraSink', durable: false }, h_execute);
        const h_value = exIdx !== undefined ? await ctx.getVariable({ id: 'ex', portName: 'low', executionIndex: exIdx, nodeTypeName: 'exprExtra' }) as number : undefined;
        await ctx.setVariable({ id: 'h', portName: 'value', executionIndex: hIdx, nodeTypeName: 'exprExtraSink', durable: false }, h_value);
        const hResult = exprExtraSink(h_execute, h_value);
        await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.onSuccess);
        await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.onFailure);
        await ctx.setVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'exprExtraSink',
          id: 'h',
          executionIndex: hIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('h', 'exprExtraSink', hIdx);
        await __ctrl__.afterNode('h', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'exprExtraSink',
          id: 'h',
          executionIndex: hIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'exprExtraSink',
            id: 'h',
            executionIndex: hIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('ex', exIdx, 'failure');
    const hIdx = ctx.addExecution('h');
    await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
    await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'exprExtraSink',
      id: 'h',
      executionIndex: hIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = hIdx !== undefined ? await ctx.getVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: fan-out-two-branches 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let aIdx: number | undefined;
  let okIdx: number | undefined;
  let a_success = false;

  await __ctrl__.beforeNode('a', ctx);

  // ── a (brA) ──
  ctx.checkAborted('a');
  aIdx = ctx.addExecution('a');
  if (ctx.shouldExecute('a', 'brA', aIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brA',
      id: 'a',
      executionIndex: aIdx,
      status: 'RUNNING',
    });

    a_success = false;

    try {
      const a_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'a', portName: 'execute', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_execute);
      const a_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'a', portName: 'value', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_value);
      const aResult = brA(a_execute, a_value);
      await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onSuccess);
      await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onFailure);
      await ctx.setVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('a', 'brA', aIdx);
      await __ctrl__.afterNode('a', ctx);
      a_success = aResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brA',
          id: 'a',
          executionIndex: aIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, false);
        await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, true);
        a_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    a_success = await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean;
  }

  if (a_success) {
    ctx.enterBranch('a', aIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('a', aIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  await __ctrl__.beforeNode('bb', ctx);
  ctx.checkAborted('bb');
  const bbIdx = ctx.addExecution('bb');
  if (ctx.shouldExecute('bb', 'brB', bbIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brB',
      id: 'bb',
      executionIndex: bbIdx,
      status: 'RUNNING',
    });
    try {
      const bb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'bb', portName: 'execute', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_execute);
      const bb_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'bb', portName: 'value', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_value);
      const bbResult = brB(bb_execute, bb_value);
      await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onSuccess);
      await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onFailure);
      await ctx.setVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('bb', 'brB', bbIdx);
      await __ctrl__.afterNode('bb', ctx);
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
      }
      throw error;
    }
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: map-iterator-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let mbIdx: number | undefined;
  let mhIdx: number | undefined;
  let mb_success = false;

  await __ctrl__.beforeNode('mb', ctx);

  // ── mb (mapBranch) ──
  ctx.checkAborted('mb');
  mbIdx = ctx.addExecution('mb');
  if (ctx.shouldExecute('mb', 'mapBranch', mbIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'mapBranch',
      id: 'mb',
      executionIndex: mbIdx,
      status: 'RUNNING',
    });

    mb_success = false;

    try {
      const mb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'mb', portName: 'execute', executionIndex: mbIdx, nodeTypeName: 'mapBranch', durable: false }, mb_execute);
      const mb_items = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as unknown[];
      await ctx.setVariable({ id: 'mb', portName: 'items', executionIndex: mbIdx, nodeTypeName: 'mapBranch', durable: false }, mb_items);
      const mb_body_scopeFn = ((ctx) => {
      return (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('mb', mbIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('mb_param_item');
        scopedCtx.setVariable({ id: 'mb', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'mapBranch', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('mb_scope_exit');
        return {  };
      };
    })(ctx);
      let mbResult: { onSuccess: boolean; onFailure: boolean; results: unknown[] };
      if (!mb_execute) {
        mbResult = { onSuccess: false, onFailure: false, results: [] };
      } else {
        const __results: unknown[] = [];
        for (const __item of mb_items) {
          __results.push((await mb_body_scopeFn(true, __item)).processed);
        }
        mbResult = { onSuccess: true, onFailure: false, results: __results };
      }
      await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.onSuccess);
      await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.onFailure);
      await ctx.setVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.results);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('mb', 'mapBranch', mbIdx);
      await __ctrl__.afterNode('mb', ctx);
      mb_success = mbResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'mapBranch',
          id: 'mb',
          executionIndex: mbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, false);
        await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, true);
        mb_success = false;
      }
      const mhIdx = ctx.addExecution('mh');
      await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, false);
      await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    mb_success = await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }) as boolean;
  }

  if (mb_success) {
    ctx.enterBranch('mb', mbIdx, 'success');
    await __ctrl__.beforeNode('mh', ctx);
    ctx.checkAborted('mh');
    mhIdx = ctx.addExecution('mh');
    if (ctx.shouldExecute('mh', 'mapSink', mhIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'RUNNING',
      });
      try {
        const mh_execute = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }) as boolean : false;
        await ctx.setVariable({ id: 'mh', portName: 'execute', executionIndex: mhIdx, nodeTypeName: 'mapSink', durable: false }, mh_execute);
        const mh_value = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }) as number : undefined;
        await ctx.setVariable({ id: 'mh', portName: 'value', executionIndex: mhIdx, nodeTypeName: 'mapSink', durable: false }, mh_value);
        const mhResult = mapSink(mh_execute, mh_value);
        await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, mhResult.onSuccess);
        await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, mhResult.onFailure);
        await ctx.setVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, mhResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'mapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('mh', 'mapSink', mhIdx);
        await __ctrl__.afterNode('mh', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'mapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'mapSink',
            id: 'mh',
            executionIndex: mhIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('mb', mbIdx, 'failure');
    const mhIdx = ctx.addExecution('mh');
    await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, false);
    await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'mapSink',
      id: 'mh',
      executionIndex: mhIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = mhIdx !== undefined ? await ctx.getVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'mapSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: neither-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  await __ctrl__.beforeNode('b', ctx);
  ctx.checkAborted('b');
  const bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'br', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });
    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'br', bIdx);
      await __ctrl__.afterNode('b', ctx);
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
      }
      throw error;
    }
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' });
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: node-scoped-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let skIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (scopedFn) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'scopedFn', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'scopedFn',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'scopedFn', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'scopedFn', durable: false }, b_value);
      const b_body_scopeFn = ((ctx) => {
      return (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('b', bIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('b_param_item');
        scopedCtx.setVariable({ id: 'b', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'scopedFn', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('b_scope_exit');
        return {  };
      };
    })(ctx);
      const bResult = scopedFn(b_execute, b_value, b_body_scopeFn);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'scopedFn',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'scopedFn', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'scopedFn',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'scopedFn',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, true);
        b_success = false;
      }
      const skIdx = ctx.addExecution('sk');
      await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
      await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'nodeScopedSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('sk', ctx);
    ctx.checkAborted('sk');
    skIdx = ctx.addExecution('sk');
    if (ctx.shouldExecute('sk', 'nodeScopedSink', skIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'nodeScopedSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'RUNNING',
      });
      try {
        const sk_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }) as boolean : false;
        await ctx.setVariable({ id: 'sk', portName: 'execute', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink', durable: false }, sk_execute);
        const sk_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'scopedFn' }) as number : undefined;
        await ctx.setVariable({ id: 'sk', portName: 'value', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink', durable: false }, sk_value);
        const skResult = nodeScopedSink(sk_execute, sk_value);
        await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.onSuccess);
        await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.onFailure);
        await ctx.setVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'nodeScopedSink',
          id: 'sk',
          executionIndex: skIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('sk', 'nodeScopedSink', skIdx);
        await __ctrl__.afterNode('sk', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'nodeScopedSink',
          id: 'sk',
          executionIndex: skIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'nodeScopedSink',
            id: 'sk',
            executionIndex: skIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const skIdx = ctx.addExecution('sk');
    await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
    await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'nodeScopedSink',
      id: 'sk',
      executionIndex: skIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = skIdx !== undefined ? await ctx.getVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: only-failure-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let failIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (br) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'br', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'br', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, true);
        b_success = false;
      }
      const failIdx = ctx.addExecution('fail');
      await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    const failIdx = ctx.addExecution('fail');
    await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'failSink',
      id: 'fail',
      executionIndex: failIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    await __ctrl__.beforeNode('fail', ctx);
    ctx.checkAborted('fail');
    failIdx = ctx.addExecution('fail');
    if (ctx.shouldExecute('fail', 'failSink', failIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'RUNNING',
      });
      try {
        const fail_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean : false;
        await ctx.setVariable({ id: 'fail', portName: 'execute', executionIndex: failIdx, nodeTypeName: 'failSink', durable: false }, fail_execute);
        const fail_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }) as number : undefined;
        await ctx.setVariable({ id: 'fail', portName: 'value', executionIndex: failIdx, nodeTypeName: 'failSink', durable: false }, fail_value);
        const failResult = failSink(fail_execute, fail_value);
        await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onSuccess);
        await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onFailure);
        await ctx.setVariable({ id: 'fail', portName: 'out', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('fail', 'failSink', failIdx);
        await __ctrl__.afterNode('fail', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'failSink',
            id: 'fail',
            executionIndex: failIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = failIdx !== undefined ? await ctx.getVariable({ id: 'fail', portName: 'out', executionIndex: failIdx, nodeTypeName: 'failSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: only-success-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (br) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'br', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'br', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: regular-branch-scoped-output 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (regScoped) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'regScoped', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'regScoped',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'regScoped', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'regScoped', durable: false }, b_value);
      const b_body_scopeFn = ((ctx) => {
      return (scopedOut: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('b', bIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_scopedOut = scopedCtx.addExecution('b_param_scopedOut');
        scopedCtx.setVariable({ id: 'b', portName: 'scopedOut', executionIndex: scopeParamIdx_scopedOut, nodeTypeName: 'regScoped', scope: 'body', side: 'start' }, scopedOut);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('b_scope_exit');
        return {  };
      };
    })(ctx);
      const bResult = regScoped(b_execute, b_value, b_body_scopeFn);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScoped',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'regScoped', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScoped',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'regScoped',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'regScoped' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScopedSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'regScopedSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScopedSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'regScopedSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'regScoped' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'regScopedSink', durable: false }, ok_value);
        const okResult = regScopedSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'regScopedSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'regScopedSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'regScopedSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'regScopedSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'regScopedSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: scopes-array-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let skIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (multiScopeFn) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'multiScopeFn', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'multiScopeFn',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'multiScopeFn', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'multiScopeFn', durable: false }, b_value);
      const bResult = multiScopeFn(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'multiScopeFn',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'multiScopeFn', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'multiScopeFn',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'multiScopeFn',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, true);
        b_success = false;
      }
      const skIdx = ctx.addExecution('sk');
      await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, false);
      await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'multiScopeSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('sk', ctx);
    ctx.checkAborted('sk');
    skIdx = ctx.addExecution('sk');
    if (ctx.shouldExecute('sk', 'multiScopeSink', skIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'multiScopeSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'RUNNING',
      });
      try {
        const sk_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }) as boolean : false;
        await ctx.setVariable({ id: 'sk', portName: 'execute', executionIndex: skIdx, nodeTypeName: 'multiScopeSink', durable: false }, sk_execute);
        const sk_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }) as number : undefined;
        await ctx.setVariable({ id: 'sk', portName: 'value', executionIndex: skIdx, nodeTypeName: 'multiScopeSink', durable: false }, sk_value);
        const skResult = multiScopeSink(sk_execute, sk_value);
        await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, skResult.onSuccess);
        await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, skResult.onFailure);
        await ctx.setVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, skResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'multiScopeSink',
          id: 'sk',
          executionIndex: skIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('sk', 'multiScopeSink', skIdx);
        await __ctrl__.afterNode('sk', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'multiScopeSink',
          id: 'sk',
          executionIndex: skIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'multiScopeSink',
            id: 'sk',
            executionIndex: skIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const skIdx = ctx.addExecution('sk');
    await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, false);
    await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'multiScopeSink',
      id: 'sk',
      executionIndex: skIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = skIdx !== undefined ? await ctx.getVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: single-both-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let failIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (br) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'br', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'br', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      const failIdx = ctx.addExecution('fail');
      await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    const failIdx = ctx.addExecution('fail');
    await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'failSink',
      id: 'fail',
      executionIndex: failIdx,
      status: 'CANCELLED',
    });
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    await __ctrl__.beforeNode('fail', ctx);
    ctx.checkAborted('fail');
    failIdx = ctx.addExecution('fail');
    if (ctx.shouldExecute('fail', 'failSink', failIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'RUNNING',
      });
      try {
        const fail_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean : false;
        await ctx.setVariable({ id: 'fail', portName: 'execute', executionIndex: failIdx, nodeTypeName: 'failSink', durable: false }, fail_execute);
        const fail_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }) as number : undefined;
        await ctx.setVariable({ id: 'fail', portName: 'value', executionIndex: failIdx, nodeTypeName: 'failSink', durable: false }, fail_value);
        const failResult = failSink(fail_execute, fail_value);
        await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onSuccess);
        await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onFailure);
        await ctx.setVariable({ id: 'fail', portName: 'out', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('fail', 'failSink', failIdx);
        await __ctrl__.afterNode('fail', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'failSink',
            id: 'fail',
            executionIndex: failIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: workflow-variant-branch-scoped-output 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: unknown): Promise<void> | void;
  afterNode(nodeId: string, ctx: unknown): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type DebugController = TDebugController;
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: TDebugger;
  readonly debugController?: DebugController;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (subWf) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'subWf', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'subWf',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'subWf', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'subWf', durable: false }, b_value);
      const b_body_scopeFn = ((ctx) => {
      return (scopedOut: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('b', bIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_scopedOut = scopedCtx.addExecution('b_param_scopedOut');
        scopedCtx.setVariable({ id: 'b', portName: 'scopedOut', executionIndex: scopeParamIdx_scopedOut, nodeTypeName: 'subWf', scope: 'body', side: 'start' }, scopedOut);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('b_scope_exit');
        return {  };
      };
    })(ctx);
      const __bParams__ = { value: b_value, __rd__: __rd__ + 1 };
      const bResult = subWf(b_execute, __bParams__, ctx.createNestedRuntime('subWf', 'b', bIdx));
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'subWf' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'subWf' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'subWf' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'subWf',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'subWf', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'subWf',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'subWf',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'subWf' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'subWf' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'subWfSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'subWf' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'subWfSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'subWfSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'subWf' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'subWfSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'subWf' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'subWfSink', durable: false }, ok_value);
        const okResult = subWfSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'subWfSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'subWfSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'subWfSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'subWfSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'subWfSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'subWfSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > prod-mode output is stable: async-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  sendStatusChangedEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendLogErrorEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendWorkflowCompletedEvent(_args: unknown): void {
    // No-op in production mode
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: unknown;
  readonly debugController?: unknown;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'brAsync', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brAsync',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'brAsync', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'brAsync', durable: false }, b_value);
      const bResult = await brAsync(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brAsync',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'brAsync', bIdx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brAsync',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brAsync',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'brAsync' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;

  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > prod-mode output is stable: async-map-iterator-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  sendStatusChangedEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendLogErrorEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendWorkflowCompletedEvent(_args: unknown): void {
    // No-op in production mode
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: unknown;
  readonly debugController?: unknown;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let mbIdx: number | undefined;
  let mhIdx: number | undefined;
  let mb_success = false;

  ctx.checkAborted('mb');
  mbIdx = ctx.addExecution('mb');
  if (ctx.shouldExecute('mb', 'asyncMapBranch', mbIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'asyncMapBranch',
      id: 'mb',
      executionIndex: mbIdx,
      status: 'RUNNING',
    });

    mb_success = false;

    try {
      const mb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'mb', portName: 'execute', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch', durable: false }, mb_execute);
      const mb_items = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as unknown[];
      await ctx.setVariable({ id: 'mb', portName: 'items', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch', durable: false }, mb_items);
      const mb_body_scopeFn = ((ctx) => {
      return async (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('mb', mbIdx!, 'body', true);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('mb_param_item');
        await scopedCtx.setVariable({ id: 'mb', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'asyncMapBranch', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('mb_scope_exit');
        return {  };
      };
    })(ctx);
      let mbResult: { onSuccess: boolean; onFailure: boolean; results: unknown[] };
      if (!mb_execute) {
        mbResult = { onSuccess: false, onFailure: false, results: [] };
      } else {
        const __results: unknown[] = [];
        for (const __item of mb_items) {
          __results.push((await mb_body_scopeFn(true, __item)).processed);
        }
        mbResult = { onSuccess: true, onFailure: false, results: __results };
      }
      await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.onSuccess);
      await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.onFailure);
      await ctx.setVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.results);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('mb', 'asyncMapBranch', mbIdx);
      mb_success = mbResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'asyncMapBranch',
          id: 'mb',
          executionIndex: mbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, false);
        await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, true);
        mb_success = false;
      }
      const mhIdx = ctx.addExecution('mh');
      await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
      await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    mb_success = await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as boolean;
  }

  if (mb_success) {
    ctx.enterBranch('mb', mbIdx, 'success');
    ctx.checkAborted('mh');
    mhIdx = ctx.addExecution('mh');
    if (ctx.shouldExecute('mh', 'asyncMapSink', mhIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'RUNNING',
      });
      try {
        const mh_execute = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as boolean : false;
        await ctx.setVariable({ id: 'mh', portName: 'execute', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink', durable: false }, mh_execute);
        const mh_value = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as number : undefined;
        await ctx.setVariable({ id: 'mh', portName: 'value', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink', durable: false }, mh_value);
        const mhResult = asyncMapSink(mh_execute, mh_value);
        await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.onSuccess);
        await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.onFailure);
        await ctx.setVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'asyncMapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('mh', 'asyncMapSink', mhIdx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'asyncMapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'asyncMapSink',
            id: 'mh',
            executionIndex: mhIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('mb', mbIdx, 'failure');
    const mhIdx = ctx.addExecution('mh');
    await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
    await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'asyncMapSink',
      id: 'mh',
      executionIndex: mhIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = mhIdx !== undefined ? await ctx.getVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }) : undefined;

  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > prod-mode output is stable: chained-branches 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  sendStatusChangedEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendLogErrorEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendWorkflowCompletedEvent(_args: unknown): void {
    // No-op in production mode
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: unknown;
  readonly debugController?: unknown;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let aIdx: number | undefined;
  let bbIdx: number | undefined;
  let okIdx: number | undefined;
  let a_success = false;
  let bb_success = false;


  ctx.checkAborted('a');
  aIdx = ctx.addExecution('a');
  if (ctx.shouldExecute('a', 'brA', aIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brA',
      id: 'a',
      executionIndex: aIdx,
      status: 'RUNNING',
    });

    a_success = false;

    try {
      const a_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'a', portName: 'execute', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_execute);
      const a_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'a', portName: 'value', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_value);
      const aResult = brA(a_execute, a_value);
      await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onSuccess);
      await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onFailure);
      await ctx.setVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('a', 'brA', aIdx);
      a_success = aResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brA',
          id: 'a',
          executionIndex: aIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, false);
        await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, true);
        a_success = false;
      }
      throw error;
    }
  } else {
    a_success = await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean;
  }

  if (a_success) {
    ctx.checkAborted('bb');
    bbIdx = ctx.addExecution('bb');
    if (ctx.shouldExecute('bb', 'brB', bbIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: 'RUNNING',
      });

      bb_success = false;

      try {
        const bb_execute = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean : false;
        await ctx.setVariable({ id: 'bb', portName: 'execute', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_execute);
        const bb_value = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }) as number : undefined;
        await ctx.setVariable({ id: 'bb', portName: 'value', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_value);
        const bbResult = brB(bb_execute, bb_value);
        await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onSuccess);
        await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onFailure);
        await ctx.setVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.result);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('bb', 'brB', bbIdx);
        bb_success = bbResult.onSuccess;
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'brB',
            id: 'bb',
            executionIndex: bbIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
          await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
          await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, true);
          bb_success = false;
        }
        const okIdx = ctx.addExecution('ok');
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'CANCELLED',
        });
        throw error;
      }
    } else {
      bb_success = await ctx.getVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }) as boolean;
    }

    if (bb_success) {
      ctx.enterBranch('bb', bbIdx, 'success');
      ctx.checkAborted('ok');
      okIdx = ctx.addExecution('ok');
      if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'RUNNING',
        });
        try {
          const ok_execute = bbIdx !== undefined ? await ctx.getVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }) as boolean : false;
          await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
          const ok_value = bbIdx !== undefined ? await ctx.getVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }) as number : undefined;
          await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
          const okResult = okSink(ok_execute, ok_value);
          await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
          await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
          await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
          await ctx.sendStatusChangedEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            status: 'SUCCEEDED',
          });
          ctx.commitNode('ok', 'okSink', okIdx);
        } catch (error: unknown) {
          if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
          const isCancellation = CancellationError.isCancellationError(error);
          await ctx.sendStatusChangedEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            status: isCancellation ? 'CANCELLED' : 'FAILED',
          });
          if (!isCancellation) {
            ctx.sendLogErrorEvent({
              nodeTypeName: 'okSink',
              id: 'ok',
              executionIndex: okIdx,
              error: error instanceof Error ? error.message : String(error),
              code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
            });
          }
          throw error;
        }
      }
      ctx.exitBranch();
    } else {
      ctx.enterBranch('bb', bbIdx, 'failure');
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      ctx.exitBranch();
    }
  } else {
    const bbIdx = ctx.addExecution('bb');
    await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
    await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brB',
      id: 'bb',
      executionIndex: bbIdx,
      status: 'CANCELLED',
    });
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;

  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > prod-mode output is stable: expression-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  sendStatusChangedEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendLogErrorEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendWorkflowCompletedEvent(_args: unknown): void {
    // No-op in production mode
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: unknown;
  readonly debugController?: unknown;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
export type { WorkflowRuntime, WorkflowRuntimeServices, CreateWorkflowRuntimeOptions, ContinuationEnvelope, DecodedContinuation, DurableGate, GateResolution, EffectAdapter, WireValue };





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let chkIdx: number | undefined;
  let hIdx: number | undefined;
  let chk_success = false;

  ctx.checkAborted('chk');
  chkIdx = ctx.addExecution('chk');
  if (ctx.shouldExecute('chk', 'checkValue', chkIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'checkValue',
      id: 'chk',
      executionIndex: chkIdx,
      status: 'RUNNING',
    });

    chk_success = false;

    try {
      await ctx.setVariable({ id: 'chk', portName: 'execute', executionIndex: chkIdx, nodeTypeName: 'checkValue', durable: false }, true);
      const chk_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'chk', portName: 'value', executionIndex: chkIdx, nodeTypeName: 'checkValue', durable: false }, chk_value);
      const chkResult = checkValue(chk_value);
      const chkResult_raw: unknown = chkResult;
      await ctx.setVariable({ id: 'chk', portName: 'result', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, typeof chkResult_raw === 'object' && chkResult_raw !== null && 'result' in chkResult_raw ? chkResult_raw.result : chkResult_raw);
      await ctx.setVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
      await ctx.setVariable({ id: 'chk', portName: 'onFailure', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'checkValue',
        id: 'chk',
        executionIndex: chkIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('chk', 'checkValue', chkIdx);
      chk_success = true;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'checkValue',
        id: 'chk',
        executionIndex: chkIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'checkValue',
          id: 'chk',
          executionIndex: chkIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, false);
        await ctx.setVariable({ id: 'chk', portName: 'onFailure', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
        chk_success = false;
      }
      const hIdx = ctx.addExecution('h');
      await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
      await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'handler',
        id: 'h',
        executionIndex: hIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    chk_success = await ctx.getVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }) as boolean;
  }

  if (chk_success) {
    ctx.enterBranch('chk', chkIdx, 'success');
    ctx.checkAborted('h');
    hIdx = ctx.addExecution('h');
    if (ctx.shouldExecute('h', 'handler', hIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'handler',
        id: 'h',
        executionIndex: hIdx,
        status: 'RUNNING',
      });
      try {
        const h_execute = chkIdx !== undefined ? await ctx.getVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }) as boolean : false;
        await ctx.setVariable({ id: 'h', portName: 'execute', executionIndex: hIdx, nodeTypeName: 'handler', durable: false }, h_execute);
        let h_value: number = undefined as unknown as number; // Required port 'value' has no connection
        await ctx.setVariable({ id: 'h', portName: 'value', executionIndex: hIdx, nodeTypeName: 'handler', durable: false }, h_value);
        const hResult = handler(h_execute, h_value);
        await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.onSuccess);
        await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.onFailure);
        await ctx.setVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'handler',
          id: 'h',
          executionIndex: hIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('h', 'handler', hIdx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'handler',
          id: 'h',
          executionIndex: hIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'handler',
            id: 'h',
            executionIndex: hIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('chk', chkIdx, 'failure');
    const hIdx = ctx.addExecution('h');
    await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
    await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'handler',
      id: 'h',
      executionIndex: hIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = hIdx !== undefined ? await ctx.getVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'handler' }) : undefined;

  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > prod-mode output is stable: expression-branch-extra-ports 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  bindWorkflow(workflowId: string, graphFingerprint: string): void {
    this.runtime.durable.bind(this.runtime, workflowId, graphFingerprint);
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  sendStatusChangedEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendLogErrorEvent(_args: unknown): void {
    // No-op in production mode
  }

  sendWorkflowCompletedEvent(_args: unknown): void {
    // No-op in production mode
  }
}

// ============================================================================
// Durable Engine
// The package's own engine, copied here so this file runs without it.
// ============================================================================

const VERSION = "0.0.0-test";
type FwMockConfig = { readonly events?: Readonly<Record<string, object>>, readonly invocations?: Readonly<Record<string, object>>, readonly agents?: Readonly<Record<string, object>>, readonly gates?: Readonly<Record<string, object>>, readonly fast?: boolean };

// ---- src/runtime/continuation-core.ts ------------------------------------------

/* The version of the engine that wrote a continuation: the package's own. */
const ENGINE_VERSION: string = VERSION;
const CONTINUATION_FORMAT_VERSION = 1 as const;
const GENERATOR_ABI = "flow-weaver-generated-v2" as const;
const MAX_CONTINUATION_BYTES = 1024 * 1024;
const MAX_CONTINUATION_DEPTH = 32;
const MAX_CONTINUATION_ENTRIES = 10_000;
const MAX_CONTINUATION_STRING_BYTES = 256 * 1024;

/*
 * Who answers a gate: a person deciding, a system supplying data, an agent
 * doing a task, or the clock (\`timer\`: a \`sleep\` node, woken by whoever
 * keeps the run when its time has come).
 */
type DurableGateKind = "approval" | "input" | "agent" | "timer";

type WireValue =
  | null
  | boolean
  | number
  | string
  | readonly WireValue[]
  | { readonly [key: string]: WireValue };

interface WorkflowFrameAddress {
  readonly workflowId: string;
  readonly invocation: number;
  readonly callerNodeId?: string;
  readonly callerExecutionIndex?: number;
}

interface ScopeAddress {
  readonly parentNodeId: string;
  readonly parentExecutionIndex: number;
  readonly scopeName: string;
  readonly invocation: number;
  readonly loopIteration?: number;
  readonly branchArm?: string;
}

interface BranchAddress {
  readonly workflowId: string;
  readonly frameDepth: number;
  readonly nodeId: string;
  readonly executionIndex: number;
  readonly arm: string;
}

interface ExecutionAddress {
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface ContinuationVariable {
  readonly address: ExecutionAddress;
  readonly portName: string;
  readonly value: WireValue;
}

interface EffectReceipt {
  readonly address: ExecutionAddress;
  readonly operationKey: string;
  readonly receipt: WireValue;
}

interface ContinuationState {
  readonly completed: readonly ExecutionAddress[];
  readonly variables: readonly ContinuationVariable[];
  readonly nextBoundary: ExecutionAddress;
}

interface DurableGate {
  readonly id: string;
  readonly kind: DurableGateKind;
  readonly address: ExecutionAddress;
  readonly payload: WireValue;
}

/* The branch arms a node sits under, as the compiled graph describes them. */
type ContinuationGraphNodeBranchPath = readonly {
  readonly nodeId: string;
  readonly arm: string;
}[];

interface ContinuationEnvelope {
  readonly formatVersion: typeof CONTINUATION_FORMAT_VERSION;
  readonly runId: string;
  readonly gateId: string;
  readonly gateKind: DurableGateKind;
  readonly workflowId: string;
  readonly bundleDigest: string;
  readonly graphFingerprint: string;
  readonly engineVersion: string;
  readonly generatorAbi: string;
  readonly location: ExecutionAddress;
  readonly state: ContinuationState;
  readonly receipts: readonly EffectReceipt[];
  readonly createdAt: string;
  readonly checksum: string;
}

declare const acceptedContinuationBrand: unique symbol;
type AcceptedContinuationEnvelope = ContinuationEnvelope & {
  readonly [acceptedContinuationBrand]: true;
};

type ContinuationRefusalReason =
  | "malformed"
  | "oversized"
  | "unsupported-format"
  | "incompatible-engine"
  | "incompatible-generator"
  | "wrong-workflow"
  | "wrong-bundle"
  | "wrong-graph"
  | "checksum-mismatch"
  | "stale-gate"
  | "wrong-run"
  | "ambiguous-effect";

interface ContinuationRefusal {
  readonly accepted: false;
  readonly reason: ContinuationRefusalReason;
  readonly message: string;
}

interface AcceptedContinuation {
  readonly accepted: true;
  readonly envelope: AcceptedContinuationEnvelope;
}

type DecodedContinuation = AcceptedContinuation | ContinuationRefusal;

/* What a resume must match before an envelope is trusted. */
interface ContinuationIdentity {
  readonly runId: string;
  readonly workflowId: string;
  /* When given, the envelope must be the one this gate answer belongs to. */
  readonly gateId?: string;
}

const ENVELOPE_KEYS = [
  "formatVersion",
  "runId",
  "gateId",
  "gateKind",
  "workflowId",
  "bundleDigest",
  "graphFingerprint",
  "engineVersion",
  "generatorAbi",
  "location",
  "state",
  "receipts",
  "createdAt",
  "checksum",
] as const;

const acceptedContinuations = new WeakSet<object>();

// ---------------------------------------------------------------------------
// Hashing. A compiled file has no \`node:crypto\`, and Web Crypto only hashes
// asynchronously, while gate ids are needed synchronously in the middle of a
// run. This is SHA-256 from the specification, over UTF-8 bytes.
// ---------------------------------------------------------------------------

function utf8BytesOf(text: string): number[] {
  const bytes: number[] = [];
  for (let index = 0; index < text.length; index++) {
    let code = text.charCodeAt(index);
    if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
      const low = text.charCodeAt(index + 1);
      if (low >= 0xdc00 && low <= 0xdfff) {
        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
        index++;
      }
    }
    // A lone surrogate is not encodable. Every UTF-8 encoder, Node's
    // included, writes the replacement character for it.
    if (code >= 0xd800 && code <= 0xdfff) code = 0xfffd;
    if (code < 0x80) bytes.push(code);
    else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
    else if (code < 0x10000) {
      bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
    } else {
      bytes.push(
        0xf0 | (code >> 18),
        0x80 | ((code >> 12) & 0x3f),
        0x80 | ((code >> 6) & 0x3f),
        0x80 | (code & 0x3f),
      );
    }
  }
  return bytes;
}

function utf8ByteLength(text: string): number {
  return utf8BytesOf(text).length;
}

const SHA256_K = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

/* The SHA-256 of a string's UTF-8 bytes, as lowercase hex. */
function sha256Hex(text: string): string {
  const bytes = utf8BytesOf(text);
  const bitLength = bytes.length * 8;
  bytes.push(0x80);
  while (bytes.length % 64 !== 56) bytes.push(0);
  // The length is a 64-bit big-endian integer. Strings this long never
  // occur, so the high word is the floor of the division.
  const high = Math.floor(bitLength / 0x100000000);
  const low = bitLength >>> 0;
  bytes.push(
    (high >>> 24) & 0xff, (high >>> 16) & 0xff, (high >>> 8) & 0xff, high & 0xff,
    (low >>> 24) & 0xff, (low >>> 16) & 0xff, (low >>> 8) & 0xff, low & 0xff,
  );

  const h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const w = new Array<number>(64);
  const rotr = (value: number, bits: number): number => (value >>> bits) | (value << (32 - bits));

  for (let offset = 0; offset < bytes.length; offset += 64) {
    for (let i = 0; i < 16; i++) {
      const j = offset + i * 4;
      w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3]) >>> 0;
    }
    for (let i = 16; i < 64; i++) {
      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);
      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) >>> 0;
    }
    let [a, b, c, d, e, f, g, hh] = h;
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      const ch = (e & f) ^ (~e & g);
      const temp1 = (hh + S1 + ch + SHA256_K[i] + w[i]) >>> 0;
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      const maj = (a & b) ^ (a & c) ^ (b & c);
      const temp2 = (S0 + maj) >>> 0;
      hh = g;
      g = f;
      f = e;
      e = (d + temp1) >>> 0;
      d = c;
      c = b;
      b = a;
      a = (temp1 + temp2) >>> 0;
    }
    h[0] = (h[0] + a) >>> 0;
    h[1] = (h[1] + b) >>> 0;
    h[2] = (h[2] + c) >>> 0;
    h[3] = (h[3] + d) >>> 0;
    h[4] = (h[4] + e) >>> 0;
    h[5] = (h[5] + f) >>> 0;
    h[6] = (h[6] + g) >>> 0;
    h[7] = (h[7] + hh) >>> 0;
  }
  return h.map((word) => word.toString(16).padStart(8, "0")).join("");
}

// ---------------------------------------------------------------------------
// Wire values: what may cross a gate or live in a continuation.
// ---------------------------------------------------------------------------

class WireValidationError extends Error {
  constructor(
    readonly reason: "malformed" | "oversized",
    message: string,
  ) {
    super(message);
    this.name = "WireValidationError";
  }
}

interface ValidationBudget {
  entries: number;
  bytes: number;
  readonly seen: Set<object>;
}

const ownKeyOf = (value: object, key: string): boolean => Object.prototype.hasOwnProperty.call(value, key);

function assertWireValue(
  value: unknown,
  path: string,
  depth: number,
  budget: ValidationBudget,
): asserts value is WireValue {
  if (depth > MAX_CONTINUATION_DEPTH) {
    throw new WireValidationError("oversized", \`\${path} exceeds maximum depth\`);
  }

  budget.entries++;
  if (budget.entries > MAX_CONTINUATION_ENTRIES) {
    throw new WireValidationError("oversized", "continuation exceeds aggregate entry limit");
  }

  if (value === null || typeof value === "boolean") return;
  if (typeof value === "number") {
    if (!Number.isFinite(value)) {
      throw new WireValidationError("malformed", \`\${path} contains a non-finite number\`);
    }
    return;
  }
  if (typeof value === "string") {
    const bytes = utf8ByteLength(value);
    if (bytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} exceeds maximum string size\`);
    }
    budget.bytes += bytes;
    if (budget.bytes > MAX_CONTINUATION_BYTES) {
      throw new WireValidationError("oversized", "continuation exceeds maximum wire size");
    }
    return;
  }
  if (
    value === undefined ||
    typeof value === "bigint" ||
    typeof value === "symbol" ||
    typeof value === "function"
  ) {
    throw new WireValidationError("malformed", \`\${path} is not a plain wire value\`);
  }
  // Everything that is not an object was returned or refused above. The cast
  // is for a compiled file checked without strictNullChecks, where \`unknown\`
  // does not narrow to \`object\` by exclusion.
  const seen = value as object;
  if (budget.seen.has(seen)) {
    throw new WireValidationError("malformed", \`\${path} contains a cycle or repeated object\`);
  }
  budget.seen.add(seen);

  if (Array.isArray(value)) {
    if (Object.getOwnPropertySymbols(value).length > 0) {
      throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
    }
    const descriptors = Object.getOwnPropertyDescriptors(value);
    for (const [key, descriptor] of Object.entries(descriptors)) {
      if (key === "length") continue;
      if (!/^(0|[1-9]\\d*)$/.test(key) || descriptor.get || descriptor.set || !descriptor.enumerable) {
        throw new WireValidationError("malformed", \`\${path} contains an accessor or property\`);
      }
    }
    for (let index = 0; index < value.length; index++) {
      if (!ownKeyOf(descriptors, String(index))) {
        throw new WireValidationError("malformed", \`\${path} contains a sparse array\`);
      }
      assertWireValue(descriptors[String(index)].value, \`\${path}[\${index}]\`, depth + 1, budget);
    }
    budget.seen.delete(seen);
    return;
  }

  const prototype = Object.getPrototypeOf(value);
  if (prototype !== Object.prototype && prototype !== null) {
    throw new WireValidationError("malformed", \`\${path} contains a class or host object\`);
  }
  if (Object.getOwnPropertySymbols(value).length > 0) {
    throw new WireValidationError("malformed", \`\${path} contains a symbol property\`);
  }
  const descriptors = Object.getOwnPropertyDescriptors(value);
  for (const [key, descriptor] of Object.entries(descriptors)) {
    if (descriptor.get || descriptor.set || !descriptor.enumerable) {
      throw new WireValidationError("malformed", \`\${path}.\${key} is an accessor or non-enumerable property\`);
    }
    const keyBytes = utf8ByteLength(key);
    if (keyBytes > MAX_CONTINUATION_STRING_BYTES) {
      throw new WireValidationError("oversized", \`\${path} contains an oversized key\`);
    }
    budget.bytes += keyBytes;
    assertWireValue(descriptor.value, \`\${path}.\${key}\`, depth + 1, budget);
  }
  budget.seen.delete(seen);
}

function validateWireValue(value: unknown): asserts value is WireValue {
  assertWireValue(value, "$", 0, { entries: 0, bytes: 0, seen: new Set() });
}

function canonicalJson(value: WireValue): string {
  if (value === null || typeof value === "boolean" || typeof value === "number") {
    return JSON.stringify(value);
  }
  if (typeof value === "string") return JSON.stringify(value);
  if (Array.isArray(value)) return \`[\${value.map(canonicalJson).join(",")}]\`;
  const record = value as { readonly [key: string]: WireValue };
  return \`{\${Object.keys(record)
    .sort()
    .map((key) => \`\${JSON.stringify(key)}:\${canonicalJson(record[key])}\`)
    .join(",")}}\`;
}

function canonicalWireValue(value: unknown): string {
  validateWireValue(value);
  return canonicalJson(value);
}

function cloneAndFreezeWireValue<T extends WireValue>(value: T): T {
  const cloned = JSON.parse(canonicalJson(value)) as T;
  const freeze = (entry: WireValue): void => {
    if (typeof entry !== "object" || entry === null) return;
    for (const child of Array.isArray(entry) ? entry : Object.values(entry)) {
      freeze(child);
    }
    Object.freeze(entry);
  };
  freeze(cloned);
  return cloned;
}

// ---------------------------------------------------------------------------
// Identity: addresses, gate ids, operation keys, checksums.
// ---------------------------------------------------------------------------

function executionAddressKey(address: ExecutionAddress): string {
  return canonicalWireValue(address);
}

function durableGateId(runId: string, kind: DurableGateKind, address: ExecutionAddress): string {
  return sha256Hex(\`\${runId}\\0\${kind}\\0\${executionAddressKey(address)}\`);
}

function operationKey(runId: string, address: ExecutionAddress): string {
  validateWireValue(address);
  return sha256Hex(\`\${runId}\\0\${canonicalJson(address as unknown as WireValue)}\`);
}

function withoutChecksum(envelope: ContinuationEnvelope): WireValue {
  const { checksum: _checksum, ...unsigned } = envelope;
  return unsigned as unknown as WireValue;
}

function continuationChecksum(envelope: ContinuationEnvelope): string {
  validateWireValue(withoutChecksum(envelope));
  return sha256Hex(canonicalJson(withoutChecksum(envelope)));
}

function createContinuationEnvelope(
  fields: Omit<
    ContinuationEnvelope,
    "formatVersion" | "engineVersion" | "generatorAbi" | "createdAt" | "checksum"
  > & {
    readonly engineVersion?: string;
    readonly generatorAbi?: string;
    readonly createdAt?: string;
  },
): ContinuationEnvelope {
  const unsigned = {
    formatVersion: CONTINUATION_FORMAT_VERSION,
    runId: fields.runId,
    gateId: fields.gateId,
    gateKind: fields.gateKind,
    workflowId: fields.workflowId,
    bundleDigest: fields.bundleDigest,
    graphFingerprint: fields.graphFingerprint,
    engineVersion: fields.engineVersion ?? VERSION,
    generatorAbi: fields.generatorAbi ?? GENERATOR_ABI,
    location: fields.location,
    state: fields.state,
    receipts: fields.receipts,
    createdAt: fields.createdAt ?? new Date().toISOString(),
  } satisfies Omit<ContinuationEnvelope, "checksum">;
  validateWireValue(unsigned);
  const envelope = Object.assign({}, unsigned, { checksum: "" }) as ContinuationEnvelope;
  return { ...envelope, checksum: continuationChecksum(envelope) };
}

// ---------------------------------------------------------------------------
// Structure: is this JSON shaped like an envelope at all?
// ---------------------------------------------------------------------------

function isPlainObjectRecord(value: unknown): value is Record<string, unknown> {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return false;
  const prototype = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
}

function hasExactlyTheKeys(value: Record<string, unknown>, keys: readonly string[]): boolean {
  const actual = Object.keys(value).sort();
  const expected = [...keys].sort();
  return actual.length === expected.length && actual.every((key, index) => key === expected[index]);
}

function hasRequiredAndOptionalKeys(
  value: Record<string, unknown>,
  required: readonly string[],
  optional: readonly string[] = [],
): boolean {
  const keys = Object.keys(value);
  return (
    required.every((key) => ownKeyOf(value, key)) &&
    keys.every((key) => required.includes(key) || optional.includes(key))
  );
}

function isNonNegativeInteger(value: unknown): value is number {
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
}

function isFrameAddress(value: unknown): value is WorkflowFrameAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(value, ["workflowId", "invocation"], ["callerNodeId", "callerExecutionIndex"]) &&
    typeof value.workflowId === "string" &&
    value.workflowId.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.callerNodeId === undefined || typeof value.callerNodeId === "string") &&
    (value.callerExecutionIndex === undefined || isNonNegativeInteger(value.callerExecutionIndex)) &&
    ((value.callerNodeId === undefined && value.callerExecutionIndex === undefined) ||
      (typeof value.callerNodeId === "string" && isNonNegativeInteger(value.callerExecutionIndex)))
  );
}

function isScopeAddress(value: unknown): value is ScopeAddress {
  return (
    isPlainObjectRecord(value) &&
    hasRequiredAndOptionalKeys(
      value,
      ["parentNodeId", "parentExecutionIndex", "scopeName", "invocation"],
      ["loopIteration", "branchArm"],
    ) &&
    typeof value.parentNodeId === "string" &&
    value.parentNodeId.length > 0 &&
    isNonNegativeInteger(value.parentExecutionIndex) &&
    typeof value.scopeName === "string" &&
    value.scopeName.length > 0 &&
    isNonNegativeInteger(value.invocation) &&
    (value.loopIteration === undefined || isNonNegativeInteger(value.loopIteration)) &&
    (value.branchArm === undefined || typeof value.branchArm === "string")
  );
}

function isExecutionAddress(value: unknown): value is ExecutionAddress {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["frames", "scopes", "branches", "nodeId", "nodeType", "executionIndex"]) &&
    Array.isArray(value.frames) &&
    value.frames.length > 0 &&
    value.frames.every(isFrameAddress) &&
    Array.isArray(value.scopes) &&
    value.scopes.every(isScopeAddress) &&
    Array.isArray(value.branches) &&
    value.branches.every(
      (branch) =>
        isPlainObjectRecord(branch) &&
        hasExactlyTheKeys(branch, ["workflowId", "frameDepth", "nodeId", "executionIndex", "arm"]) &&
        typeof branch.workflowId === "string" &&
        branch.workflowId.length > 0 &&
        isNonNegativeInteger(branch.frameDepth) &&
        typeof branch.nodeId === "string" &&
        branch.nodeId.length > 0 &&
        isNonNegativeInteger(branch.executionIndex) &&
        typeof branch.arm === "string" &&
        branch.arm.length > 0,
    ) &&
    typeof value.nodeId === "string" &&
    value.nodeId.length > 0 &&
    typeof value.nodeType === "string" &&
    value.nodeType.length > 0 &&
    isNonNegativeInteger(value.executionIndex)
  );
}

function isContinuationVariable(value: unknown): value is ContinuationVariable {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "portName", "value"]) &&
    isExecutionAddress(value.address) &&
    typeof value.portName === "string" &&
    value.portName.length > 0
  );
}

function isEffectReceipt(value: unknown): value is EffectReceipt {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["address", "operationKey", "receipt"]) &&
    isExecutionAddress(value.address) &&
    typeof value.operationKey === "string" &&
    /^[0-9a-f]{64}$/.test(value.operationKey)
  );
}

function isContinuationState(value: unknown): value is ContinuationState {
  return (
    isPlainObjectRecord(value) &&
    hasExactlyTheKeys(value, ["completed", "variables", "nextBoundary"]) &&
    Array.isArray(value.completed) &&
    value.completed.every(isExecutionAddress) &&
    Array.isArray(value.variables) &&
    value.variables.every(isContinuationVariable) &&
    isExecutionAddress(value.nextBoundary)
  );
}

function isExactIsoUtc(value: string): boolean {
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) && new Date(timestamp).toISOString() === value;
}

function structurallyValidEnvelope(value: unknown): value is ContinuationEnvelope {
  if (!isPlainObjectRecord(value) || !hasExactlyTheKeys(value, ENVELOPE_KEYS)) return false;
  return !(
    typeof value.formatVersion !== "number" ||
    typeof value.runId !== "string" ||
    typeof value.gateId !== "string" ||
    !["approval", "input", "agent", "timer"].includes(value.gateKind as string) ||
    typeof value.workflowId !== "string" ||
    typeof value.bundleDigest !== "string" ||
    typeof value.graphFingerprint !== "string" ||
    typeof value.engineVersion !== "string" ||
    typeof value.generatorAbi !== "string" ||
    typeof value.createdAt !== "string" ||
    typeof value.checksum !== "string" ||
    value.runId.length === 0 ||
    !/^[0-9a-f]{64}$/.test(value.gateId) ||
    value.workflowId.length === 0 ||
    value.engineVersion.length === 0 ||
    value.generatorAbi.length === 0 ||
    !isExecutionAddress(value.location) ||
    !isContinuationState(value.state) ||
    !Array.isArray(value.receipts) ||
    !value.receipts.every(isEffectReceipt) ||
    !/^sha256:[0-9a-f]{64}$/.test(value.bundleDigest) ||
    !/^[0-9a-f]{64}$/.test(value.graphFingerprint) ||
    !/^[0-9a-f]{64}$/.test(value.checksum) ||
    !isExactIsoUtc(value.createdAt) ||
    executionAddressKey(value.location) !== executionAddressKey(value.state.nextBoundary)
  );
}

// ---------------------------------------------------------------------------
// Acceptance: the checks a host can make without the compiled graph.
// ---------------------------------------------------------------------------

/*
 * Take an envelope back from wherever a host kept it. It is parsed when given
 * as text, checked for shape, checksum, gate identity, engine and generator
 * versions, and bound to the run and workflow it is about to resume. What is
 * accepted is a frozen copy; the input is never trusted afterwards.
 *
 * This is what the compiled file offers a host of its own. The coordinator's
 * \`decodeContinuation\` does this and, having the compiled graph, more.
 */
function acceptContinuation(input: unknown, identity: ContinuationIdentity): DecodedContinuation {
  let value: unknown = input;
  if (typeof input === "string") {
    if (utf8ByteLength(input) > MAX_CONTINUATION_BYTES) {
      return { accepted: false, reason: "oversized", message: "continuation exceeds maximum wire size" };
    }
    try {
      value = JSON.parse(input);
    } catch {
      return { accepted: false, reason: "malformed", message: "continuation is not valid JSON" };
    }
  }
  try {
    validateWireValue(value);
  } catch (error) {
    if (error instanceof WireValidationError) {
      return { accepted: false, reason: error.reason, message: error.message };
    }
    return { accepted: false, reason: "malformed", message: "continuation is not a wire value" };
  }
  if (!structurallyValidEnvelope(value)) {
    return { accepted: false, reason: "malformed", message: "continuation has missing, unknown, or invalid fields" };
  }
  if (value.formatVersion !== CONTINUATION_FORMAT_VERSION) {
    return { accepted: false, reason: "unsupported-format", message: \`unsupported continuation format \${value.formatVersion}\` };
  }
  if (continuationChecksum(value) !== value.checksum) {
    return { accepted: false, reason: "checksum-mismatch", message: "continuation checksum does not match" };
  }
  if (value.gateId !== durableGateId(value.runId, value.gateKind, value.location)) {
    return { accepted: false, reason: "malformed", message: "continuation gate identity does not match its execution address" };
  }
  if (value.engineVersion !== VERSION) {
    return { accepted: false, reason: "incompatible-engine", message: \`continuation was written by engine \${value.engineVersion}, this is \${VERSION}\` };
  }
  if (value.generatorAbi !== GENERATOR_ABI) {
    return { accepted: false, reason: "incompatible-generator", message: "continuation generator ABI does not match" };
  }
  if (value.runId !== identity.runId) {
    return { accepted: false, reason: "wrong-run", message: "continuation belongs to another run" };
  }
  if (value.workflowId !== identity.workflowId) {
    return { accepted: false, reason: "wrong-workflow", message: "continuation belongs to another workflow" };
  }
  if (identity.gateId !== undefined && value.gateId !== identity.gateId) {
    return { accepted: false, reason: "stale-gate", message: "continuation gate is stale or reordered" };
  }
  const accepted = cloneAndFreezeWireValue(value as unknown as WireValue) as unknown as AcceptedContinuationEnvelope;
  acceptedContinuations.add(accepted);
  return { accepted: true, envelope: accepted };
}

function assertAcceptedContinuation(
  value: ContinuationEnvelope,
): asserts value is AcceptedContinuationEnvelope {
  if (!acceptedContinuations.has(value)) {
    throw new Error("ContinuationEnvelope must come from a successful decodeContinuation or acceptContinuation result");
  }
}

// ---- src/runtime/durable-execution.ts ------------------------------------------

interface GateResolution {
  readonly gateId: string;
  readonly value: WireValue;
}

function acceptGateResolution(resolution: GateResolution | undefined): GateResolution | undefined {
  if (resolution === undefined) return undefined;
  validateWireValue(resolution);
  const keys = Object.keys(resolution).sort();
  if (keys.length !== 2 || keys[0] !== 'gateId' || keys[1] !== 'value' || !/^[0-9a-f]{64}$/.test(resolution.gateId)) {
    throw new Error('resolution must contain exactly a canonical gateId and wire value');
  }
  return cloneAndFreezeWireValue(resolution as unknown as WireValue) as unknown as GateResolution;
}

type EffectRecovery =
  | { readonly kind: 'not-committed' }
  | {
      readonly kind: 'committed';
      readonly receipt: WireValue;
      readonly result: WireValue;
    }
  | { readonly kind: 'repeatable' }
  | { readonly kind: 'ambiguous' };

interface EffectAdapter {
  recover(operationKey: string, address: ExecutionAddress): Promise<EffectRecovery>;
  /* Persist the exact successful effect result before it enters a continuation. */
  commit?(
    operationKey: string,
    address: ExecutionAddress,
    execution: EffectExecution<WireValue>,
  ): Promise<void>;
}

interface WorkflowRuntimeServices {
  readonly debugger?: unknown;
  readonly debugController?: unknown;
  readonly mocks?: FwMockConfig;
  readonly workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>;
  readonly effectAdapter?: EffectAdapter;
}

/*
 * The engine as a generated body sees it. It is an interface, not the class,
 * so a runtime built by the package and one built by a compiled file's own
 * copy of the engine are interchangeable to the type checker: two classes
 * with private members never are.
 */
interface DurableEngine {
  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress;
  /* Called once at the top of a root body: the workflow's name and graph identity. */
  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void;
  shouldExecute(address: ExecutionAddress): boolean;
  commitNode(address: ExecutionAddress): void;
  setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue;
  executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T>;
  assertResumeResolutionConsumed(): void;
}

interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: WorkflowRuntimeServices;
  readonly durable: DurableEngine;
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
}

interface NodeExecutionRuntime {
  readonly nodeId: string;
  readonly runtime: WorkflowRuntime;
  readonly recursionDepth: number;
  createNestedRuntime(workflowId: string): WorkflowRuntime;
}

interface CreateWorkflowRuntimeOptions {
  readonly runId: string;
  readonly workflowId: string;
  readonly abortSignal?: AbortSignal;
  readonly services?: WorkflowRuntimeServices;
  readonly continuation?: AcceptedContinuationEnvelope;
  readonly resolution?: GateResolution;
  /*
   * The identity of the compiled artifact this run executes, \`sha256:<hex>\`.
   * A coordinator that hashes the artifact passes it, and a continuation is
   * refused on resume when it names another. Left out, the engine derives one
   * from the workflow's own graph identity, so a host that keeps a
   * continuation and brings it back to the same compiled file needs nothing
   * more.
   */
  readonly bundleDigest?: string;
}

interface GateBoundary {
  readonly kind: DurableGateKind;
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
  readonly payload: WireValue;
}

/*
 * A gate answered from the mocks, or undefined to yield for real.
 *
 * Any gate is answered by its node id through \`gates\`, with its data outputs
 * as the object. The built-in agent and event gates are also answered from
 * their own sections, keyed by what the node was given as its first input
 * (the agent id, the event name), by \`node:key\`, or by \`node:*\`. The answer
 * becomes the gate's whole output envelope, control ports filled in, which
 * is exactly what a person's answer becomes in \`buildGateResolution\`.
 */
function mockedGateAnswer(mocks: FwMockConfig | undefined, boundary: GateBoundary): WireValue | undefined {
  if (!mocks) return undefined;
  const { nodeId, nodeType } = boundary;
  const pick = (section: Record<string, object> | undefined, key: string | undefined): object | undefined => {
    if (!section) return undefined;
    if (key !== undefined && section[\`\${nodeId}:\${key}\`] !== undefined) return section[\`\${nodeId}:\${key}\`];
    if (section[\`\${nodeId}:*\`] !== undefined) return section[\`\${nodeId}:*\`];
    return key !== undefined ? section[key] : undefined;
  };
  const firstInput = (): string | undefined => {
    const p = boundary.payload as { arguments?: Array<{ value?: unknown; absent?: boolean }> } | null;
    const v = p?.arguments?.[0]?.value;
    return v === undefined || v === null ? undefined : String(v);
  };
  let data: object | undefined = mocks.gates?.[nodeId];
  if (data === undefined && nodeType === 'waitForAgent') {
    const v = pick(mocks.agents, firstInput());
    if (v !== undefined) data = { agentResult: v };
  }
  if (data === undefined && nodeType === 'waitForEvent') {
    const v = pick(mocks.events, firstInput());
    if (v !== undefined) data = { eventData: v };
  }
  // \`fast\` skips waits: a sleeping run wakes at once, as \`delay\` returns at once.
  if (data === undefined && nodeType === 'sleep' && mocks.fast === true) {
    data = { wokeAt: new Date().toISOString() };
  }
  if (data === undefined || typeof data !== 'object') return undefined;
  const value = { onSuccess: true, onFailure: false, ...(data as Record<string, unknown>) };
  validateWireValue(value);
  return value as WireValue;
}

interface EffectBoundary {
  readonly nodeId: string;
  readonly nodeType: string;
  readonly executionIndex: number;
}

interface EffectExecution<T extends WireValue> {
  readonly result: T;
  readonly receipt: WireValue;
}

/*
 * Thrown out of a generated body when a gate has to wait for the outside.
 * It carries everything a host needs to keep: the gate to answer, and the
 * continuation to bring back with the answer. \`continuation\` is present when
 * the body declared its identity (every body compiled by this version does);
 * a coordinator may also build its own from \`state\` and \`receipts\`.
 */
class DurableGateYield extends Error {
  readonly code = 'FLOW_WEAVER_DURABLE_GATE_YIELD';

  constructor(
    readonly gate: DurableGate,
    readonly state: ContinuationState,
    readonly receipts: readonly EffectReceipt[],
    readonly continuation?: ContinuationEnvelope,
  ) {
    super(\`Workflow yielded at \${gate.kind} gate "\${gate.id}"\`);
    this.name = 'DurableGateYield';
  }
}

class AmbiguousEffectError extends Error {
  readonly code = 'FLOW_WEAVER_AMBIGUOUS_EFFECT';

  constructor(
    readonly operationKey: string,
    readonly address: ExecutionAddress,
  ) {
    super(\`Effect "\${operationKey}" has an ambiguous commit state\`);
    this.name = 'AmbiguousEffectError';
  }
}

function durableAddressKey(address: ExecutionAddress): string {
  return executionAddressKey(address);
}

function durableVariableKey(address: ExecutionAddress, portName: string): string {
  return \`\${executionAddressKey(address)}\\0\${portName}\`;
}

function cloneExecutionAddress(address: ExecutionAddress): ExecutionAddress {
  return {
    frames: address.frames.map((frame) => ({ ...frame })),
    scopes: address.scopes.map((scope) => ({ ...scope })),
    branches: address.branches.map((branch) => ({ ...branch })),
    nodeId: address.nodeId,
    nodeType: address.nodeType,
    executionIndex: address.executionIndex,
  };
}

function isCanonicalPrefix(candidate: readonly unknown[], current: readonly unknown[]): boolean {
  return (
    candidate.length <= current.length &&
    canonicalWireValue(candidate) === canonicalWireValue(current.slice(0, candidate.length))
  );
}

function isCanonicalEqual(left: readonly unknown[], right: readonly unknown[]): boolean {
  return left.length === right.length && canonicalWireValue(left) === canonicalWireValue(right);
}

function requireEffectRecovery(value: unknown, key: string, address: ExecutionAddress): EffectRecovery {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  const kind = record.kind;
  if ((kind === 'not-committed' || kind === 'repeatable' || kind === 'ambiguous') && Object.keys(record).length === 1) {
    return { kind };
  }
  if (
    kind === 'committed' &&
    Object.keys(record).length === 3 &&
    Object.prototype.hasOwnProperty.call(record, 'receipt') &&
    Object.prototype.hasOwnProperty.call(record, 'result')
  ) {
    return {
      kind,
      receipt: record.receipt as WireValue,
      result: record.result as WireValue,
    };
  }
  throw new AmbiguousEffectError(key, address);
}

function requireEffectExecution<T extends WireValue>(
  value: unknown,
  key: string,
  address: ExecutionAddress,
): EffectExecution<T> {
  try {
    validateWireValue(value);
  } catch {
    throw new AmbiguousEffectError(key, address);
  }
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new AmbiguousEffectError(key, address);
  }
  const record = value as Record<string, unknown>;
  if (
    Object.keys(record).length !== 2 ||
    !Object.prototype.hasOwnProperty.call(record, 'result') ||
    !Object.prototype.hasOwnProperty.call(record, 'receipt')
  ) {
    throw new AmbiguousEffectError(key, address);
  }
  return {
    result: record.result as T,
    receipt: record.receipt as WireValue,
  };
}

class DurableExecution implements DurableEngine {
  private readonly completed = new Map<string, ExecutionAddress>();
  private readonly variables = new Map<string, Omit<ContinuationVariable, 'value'> & { readonly value: unknown }>();
  private readonly receipts = new Map<string, EffectReceipt>();
  private readonly resumeEnvelope?: ContinuationEnvelope;
  private readonly resolution?: GateResolution;
  private readonly givenBundleDigest?: string;
  private graphFingerprint?: string;
  private resolutionConsumed = false;

  constructor(
    readonly runId: string,
    readonly workflowId: string,
    continuation?: AcceptedContinuationEnvelope,
    resolution?: GateResolution,
    bundleDigest?: string,
  ) {
    if (continuation !== undefined) {
      assertAcceptedContinuation(continuation);
      if (continuation.runId !== runId) {
        throw new Error('accepted continuation belongs to another run');
      }
      if (continuation.workflowId !== workflowId) {
        throw new Error('accepted continuation belongs to another workflow');
      }
    }
    if (bundleDigest !== undefined && !/^sha256:[0-9a-f]{64}$/.test(bundleDigest)) {
      throw new Error('bundleDigest must use canonical sha256:<64hex> form');
    }
    this.givenBundleDigest = bundleDigest;
    this.resumeEnvelope = continuation;
    this.resolution = acceptGateResolution(resolution);

    for (const address of continuation?.state.completed ?? []) {
      this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
    }
    for (const variable of continuation?.state.variables ?? []) {
      this.variables.set(durableVariableKey(variable.address, variable.portName), {
        address: cloneExecutionAddress(variable.address),
        portName: variable.portName,
        value: variable.value,
      });
    }
    for (const receipt of continuation?.receipts ?? []) {
      this.receipts.set(durableAddressKey(receipt.address), {
        address: cloneExecutionAddress(receipt.address),
        operationKey: receipt.operationKey,
        receipt: receipt.receipt,
      });
    }
  }

  address(
    runtime: Pick<WorkflowRuntime, 'frames' | 'scopes' | 'branches'>,
    nodeId: string,
    nodeType: string,
    executionIndex: number,
  ): ExecutionAddress {
    return {
      frames: runtime.frames.map((frame) => ({ ...frame })),
      scopes: runtime.scopes.map((scope) => ({ ...scope })),
      branches: runtime.branches.map((branch) => ({ ...branch })),
      nodeId,
      nodeType,
      executionIndex,
    };
  }

  /*
   * The artifact identity this run executes under: the one the coordinator
   * gave, or one derived from the graph identity the body declared. Known
   * only after \`bind\`.
   */
  bundleDigest(): string | undefined {
    if (this.givenBundleDigest !== undefined) return this.givenBundleDigest;
    if (this.graphFingerprint === undefined) return undefined;
    return \`sha256:\${sha256Hex(\`flow-weaver-inline\\0\${this.workflowId}\\0\${this.graphFingerprint}\\0\${ENGINE_VERSION}\`)}\`;
  }

  bind(runtime: Pick<WorkflowRuntime, 'frames'>, workflowId: string, graphFingerprint: string): void {
    // Nested bodies (a workflow used as a node, \`invokeWorkflow\`) bind too;
    // only the root frame names the run's graph.
    if (runtime.frames.length !== 1) return;
    if (workflowId !== this.workflowId) {
      throw new Error(\`runtime was created for workflow "\${this.workflowId}" but "\${workflowId}" is running on it\`);
    }
    this.graphFingerprint = graphFingerprint;
    if (this.resumeEnvelope === undefined) return;
    if (this.resumeEnvelope.graphFingerprint !== graphFingerprint) {
      const error = new Error('continuation belongs to another workflow graph');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
    const bundleDigest = this.bundleDigest();
    if (bundleDigest !== undefined && this.resumeEnvelope.bundleDigest !== bundleDigest) {
      const error = new Error('continuation belongs to another bundle');
      error.name = 'ContinuationMismatchError';
      throw error;
    }
  }

  shouldExecute(address: ExecutionAddress): boolean {
    return !this.completed.has(durableAddressKey(address));
  }

  commitNode(address: ExecutionAddress): void {
    this.completed.set(durableAddressKey(address), cloneExecutionAddress(address));
  }

  setVariable(address: ExecutionAddress, portName: string, value: unknown): void {
    this.variables.set(durableVariableKey(address, portName), {
      address: cloneExecutionAddress(address),
      portName,
      value,
    });
  }

  getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup = true): unknown {
    const exact = this.variables.get(durableVariableKey(address, portName));
    if (exact !== undefined) return exact.value;
    if (!allowAncestorLookup) return undefined;

    const candidates = [...this.variables.values()]
      .filter(
        (variable) =>
          variable.portName === portName &&
          variable.address.nodeId === address.nodeId &&
          variable.address.nodeType === address.nodeType &&
          variable.address.executionIndex === address.executionIndex &&
          isCanonicalPrefix(variable.address.frames, address.frames) &&
          isCanonicalPrefix(variable.address.scopes, address.scopes) &&
          isCanonicalPrefix(variable.address.branches, address.branches),
      )
      .sort(
        (left, right) =>
          right.address.frames.length +
          right.address.scopes.length +
          right.address.branches.length -
          (left.address.frames.length + left.address.scopes.length + left.address.branches.length),
      );
    const specificity = (candidate: (typeof candidates)[number]): number =>
      candidate.address.frames.length + candidate.address.scopes.length + candidate.address.branches.length;
    if (candidates.length > 1 && specificity(candidates[0]) === specificity(candidates[1])) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    if (candidates[0] !== undefined) return candidates[0].value;

    // Generated workflows leave a selected control-flow branch before
    // projecting its outputs through Exit. A fresh continuation resume has no
    // process-local variable cache, so that projection must recover the one
    // value committed by the branch that actually ran. This is deliberately
    // narrower than ancestor lookup: it cannot cross workflow frames or
    // scopes, and more than one compatible descendant fails closed.
    const converged = [...this.variables.values()].filter(
      (variable) =>
        variable.portName === portName &&
        variable.address.nodeId === address.nodeId &&
        variable.address.nodeType === address.nodeType &&
        variable.address.executionIndex === address.executionIndex &&
        isCanonicalEqual(variable.address.frames, address.frames) &&
        isCanonicalEqual(variable.address.scopes, address.scopes) &&
        isCanonicalPrefix(address.branches, variable.address.branches),
    );
    if (converged.length > 1) {
      throw new Error(\`Ambiguous durable variable address for \${address.nodeId}.\${portName}\`);
    }
    return converged[0]?.value;
  }

  resolveGate(runtime: WorkflowRuntime, boundary: GateBoundary): WireValue {
    validateWireValue(boundary.payload);
    // A mocked gate is answered here, on the first run and on every replay
    // alike, so it never pauses and never enters the resume bookkeeping below.
    const mocked = mockedGateAnswer(runtime.services.mocks, boundary);
    if (mocked !== undefined) return mocked;
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const id = durableGateId(this.runId, boundary.kind, address);

    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      if (
        durableAddressKey(this.resumeEnvelope.location) !== durableAddressKey(address) ||
        this.resumeEnvelope.gateId !== id ||
        this.resumeEnvelope.gateKind !== boundary.kind ||
        this.resolution === undefined ||
        this.resolution.gateId !== id
      ) {
        const error = new Error('Gate resolution is stale, reordered, or does not match the resume boundary');
        error.name = 'StaleGateError';
        throw error;
      }
      validateWireValue(this.resolution.value);
      this.resolutionConsumed = true;
      return this.resolution.value;
    }

    if (this.resumeEnvelope !== undefined && durableAddressKey(this.resumeEnvelope.location) === durableAddressKey(address)) {
      const error = new Error('The consumed resume gate was re-entered');
      error.name = 'StaleGateError';
      throw error;
    }

    const gate: DurableGate = {
      id,
      kind: boundary.kind,
      address,
      payload: boundary.payload,
    };
    const state = this.snapshot(address);
    const receipts = [...this.receipts.values()];
    const bundleDigest = this.bundleDigest();
    const continuation =
      this.graphFingerprint === undefined || bundleDigest === undefined
        ? undefined
        : createContinuationEnvelope({
            runId: this.runId,
            gateId: id,
            gateKind: boundary.kind,
            workflowId: this.workflowId,
            bundleDigest,
            graphFingerprint: this.graphFingerprint,
            location: address,
            state,
            receipts,
          });
    throw new DurableGateYield(gate, state, receipts, continuation);
  }

  async executeEffect<T extends WireValue>(
    runtime: WorkflowRuntime,
    boundary: EffectBoundary,
    execute: (operationKey: string) => Promise<EffectExecution<T>>,
  ): Promise<T> {
    const address = this.address(runtime, boundary.nodeId, boundary.nodeType, boundary.executionIndex);
    const key = operationKey(this.runId, address);
    const committed = this.receipts.get(durableAddressKey(address));
    if (committed !== undefined) {
      throw new Error(\`Committed effect "\${key}" reached its execution body\`);
    }

    let recovery: EffectRecovery | undefined;
    try {
      recovery = await runtime.services.effectAdapter?.recover(key, address);
    } catch {
      throw new AmbiguousEffectError(key, address);
    }
    if (recovery === undefined) {
      throw new AmbiguousEffectError(key, address);
    }
    recovery = requireEffectRecovery(recovery, key, address);
    if (recovery.kind === 'ambiguous') throw new AmbiguousEffectError(key, address);
    if (recovery.kind === 'committed') {
      this.receipts.set(durableAddressKey(address), {
        address: cloneExecutionAddress(address),
        operationKey: key,
        receipt: recovery.receipt,
      });
      return recovery.result as T;
    }

    let executed: EffectExecution<T>;
    try {
      executed = requireEffectExecution<T>(await execute(key), key, address);
    } catch (error) {
      let afterFailure: EffectRecovery;
      try {
        afterFailure =
          (await runtime.services.effectAdapter?.recover(key, address)) ?? ({ kind: 'ambiguous' } as const);
      } catch {
        throw new AmbiguousEffectError(key, address);
      }
      afterFailure = requireEffectRecovery(afterFailure, key, address);
      if (afterFailure.kind === 'committed') {
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: afterFailure.receipt,
        });
        return afterFailure.result as T;
      }
      if (afterFailure.kind === 'ambiguous') {
        throw new AmbiguousEffectError(key, address);
      }
      throw error;
    }
    if (runtime.services.effectAdapter?.commit !== undefined) {
      try {
        await runtime.services.effectAdapter.commit(key, address, executed);
      } catch {
        let committed: EffectRecovery;
        try {
          committed = requireEffectRecovery(
            await runtime.services.effectAdapter.recover(key, address),
            key,
            address,
          );
        } catch {
          throw new AmbiguousEffectError(key, address);
        }
        if (
          committed.kind !== 'committed' ||
          canonicalWireValue(committed.receipt) !== canonicalWireValue(executed.receipt) ||
          canonicalWireValue(committed.result) !== canonicalWireValue(executed.result)
        ) throw new AmbiguousEffectError(key, address);
        this.receipts.set(durableAddressKey(address), {
          address: cloneExecutionAddress(address),
          operationKey: key,
          receipt: committed.receipt,
        });
        return committed.result as T;
      }
    }
    this.receipts.set(durableAddressKey(address), {
      address: cloneExecutionAddress(address),
      operationKey: key,
      receipt: executed.receipt,
    });
    return executed.result;
  }

  snapshot(nextBoundary: ExecutionAddress): ContinuationState {
    const completedKeys = new Set(this.completed.keys());
    return {
      completed: [...this.completed.values()].map(cloneExecutionAddress),
      variables: [...this.variables.values()]
        .filter((variable) => completedKeys.has(durableAddressKey(variable.address)))
        .map((variable) => {
          try {
            validateWireValue(variable.value);
          } catch (error) {
            throw new Error(
              \`Continuation variable \${variable.address.nodeId}.\${variable.portName} is not a wire value: \${error instanceof Error ? error.message : String(error)}\`,
            );
          }
          return {
            address: cloneExecutionAddress(variable.address),
            portName: variable.portName,
            value: variable.value,
          };
        }),
      nextBoundary: cloneExecutionAddress(nextBoundary),
    };
  }

  assertResumeResolutionConsumed(): void {
    if (this.resumeEnvelope !== undefined && !this.resolutionConsumed) {
      const error = new Error('Resumed execution completed or yielded without consuming its exact gate resolution');
      error.name = 'UnconsumedGateResolutionError';
      throw error;
    }
  }
}

function createWorkflowRuntime(options: CreateWorkflowRuntimeOptions): WorkflowRuntime {
  if (options.runId.trim().length === 0) {
    throw new Error('runId must be a non-empty coordinator-owned identity');
  }
  const rootFrame: WorkflowFrameAddress = {
    workflowId: options.workflowId,
    invocation: 0,
  };
  return {
    runId: options.runId,
    abortSignal: options.abortSignal,
    services: options.services ?? {},
    durable: new DurableExecution(
      options.runId,
      options.workflowId,
      options.continuation,
      options.resolution,
      options.bundleDigest,
    ),
    frames: [rootFrame],
    scopes: [],
    branches: [],
  };
}

function createNestedWorkflowRuntime(
  runtime: WorkflowRuntime,
  workflowId: string,
  callerNodeId: string,
  callerExecutionIndex: number,
  invocation: number,
): WorkflowRuntime {
  return {
    ...runtime,
    frames: [
      ...runtime.frames,
      {
        workflowId,
        invocation,
        callerNodeId,
        callerExecutionIndex,
      },
    ],
    scopes: runtime.scopes,
    branches: runtime.branches,
  };
}

function createScopedWorkflowRuntime(runtime: WorkflowRuntime, scope: ScopeAddress): WorkflowRuntime {
  return {
    ...runtime,
    scopes: [...runtime.scopes, scope],
    branches: runtime.branches,
  };
}

function isDurableGateYield(error: unknown): error is DurableGateYield {
  return (
    error instanceof DurableGateYield ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_DURABLE_GATE_YIELD')
  );
}

function isAmbiguousEffectError(error: unknown): error is AmbiguousEffectError {
  return (
    error instanceof AmbiguousEffectError ||
    (typeof error === 'object' &&
      error !== null &&
      (error as { code?: unknown }).code === 'FLOW_WEAVER_AMBIGUOUS_EFFECT')
  );
}


export { createWorkflowRuntime, acceptContinuation, createContinuationEnvelope, isDurableGateYield, isAmbiguousEffectError, DurableGateYield, AmbiguousEffectError, CancellationError, ENGINE_VERSION };
