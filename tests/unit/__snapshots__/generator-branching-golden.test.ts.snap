      await ctx.setVariable({ id: 'mh', portName: 'execute', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, mh_execute);
      const mh_value = await ctx.getVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx! }) as number;
