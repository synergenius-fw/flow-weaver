class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let bIdx: number | undefined;
  let skIdx: number | undefined;
  let b_success = false;

  if (await __ctrl__.beforeNode('b', ctx)) {

    // ── b (scopedFn) ──
    ctx.checkAborted('b');
    bIdx = ctx.addExecution('b');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'b';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'scopedFn',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, b_value);
      const b_body_scopeFn = ((ctx) => {
      return (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('b', bIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('b_param_item');
        scopedCtx.setVariable({ id: 'b', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'scopedFn', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('b_scope_exit');
        return {  };
      };
    })(ctx);
      const bResult = scopedFn(b_execute, b_value, b_body_scopeFn);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'scopedFn',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'scopedFn',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'scopedFn',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, true);
        b_success = false;
      }
      const skIdx = ctx.addExecution('sk');
      await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
      await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'nodeScopedSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    bIdx = ctx.addExecution('b');
    b_success = true;
  }

  if (b_success) {
    if (await __ctrl__.beforeNode('sk', ctx)) {
      ctx.checkAborted('sk');
      skIdx = ctx.addExecution('sk');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'sk';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'nodeScopedSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'RUNNING',
      });
      try {
        const sk_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx }) as boolean : false;
        await ctx.setVariable({ id: 'sk', portName: 'execute', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, sk_execute);
        const sk_value = await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx! }) as number;
        await ctx.setVariable({ id: 'sk', portName: 'value', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, sk_value);
        const skResult = nodeScopedSink(sk_execute, sk_value);
        await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.onSuccess);
        await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.onFailure);
        await ctx.setVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'nodeScopedSink',
          id: 'sk',
          executionIndex: skIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('sk', ctx);
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'nodeScopedSink',
          id: 'sk',
          executionIndex: skIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'nodeScopedSink',
            id: 'sk',
            executionIndex: skIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    } else {
      skIdx = ctx.addExecution('sk');
    }
  } else {
    const skIdx = ctx.addExecution('sk');
    await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
    await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'nodeScopedSink',
      id: 'sk',
      executionIndex: skIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = skIdx !== undefined ? await ctx.getVariable({ id: 'sk', portName: 'out', executionIndex: skIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: only-failure-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let bIdx: number | undefined;
  let failIdx: number | undefined;
  let b_success = false;

  if (await __ctrl__.beforeNode('b', ctx)) {

    // ── b (br) ──
    ctx.checkAborted('b');
    bIdx = ctx.addExecution('b');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'b';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br' }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br' }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, true);
        b_success = false;
      }
      const failIdx = ctx.addExecution('fail');
      await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    bIdx = ctx.addExecution('b');
    b_success = true;
  }

  if (b_success) {
    const failIdx = ctx.addExecution('fail');
    await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'failSink',
      id: 'fail',
      executionIndex: failIdx,
      status: 'CANCELLED',
    });
  } else {
    if (await __ctrl__.beforeNode('fail', ctx)) {
      ctx.checkAborted('fail');
      failIdx = ctx.addExecution('fail');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'fail';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'RUNNING',
      });
      try {
        const fail_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx }) as boolean : false;
        await ctx.setVariable({ id: 'fail', portName: 'execute', executionIndex: failIdx, nodeTypeName: 'failSink' }, fail_execute);
        const fail_value = await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx! }) as number;
        await ctx.setVariable({ id: 'fail', portName: 'value', executionIndex: failIdx, nodeTypeName: 'failSink' }, fail_value);
        const failResult = failSink(fail_execute, fail_value);
        await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onSuccess);
        await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onFailure);
        await ctx.setVariable({ id: 'fail', portName: 'out', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('fail', ctx);
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'failSink',
            id: 'fail',
            executionIndex: failIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    } else {
      failIdx = ctx.addExecution('fail');
    }
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = failIdx !== undefined ? await ctx.getVariable({ id: 'fail', portName: 'out', executionIndex: failIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: only-success-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  if (await __ctrl__.beforeNode('b', ctx)) {

    // ── b (br) ──
    ctx.checkAborted('b');
    bIdx = ctx.addExecution('b');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'b';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br' }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br' }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    bIdx = ctx.addExecution('b');
    b_success = true;
  }

  if (b_success) {
    if (await __ctrl__.beforeNode('ok', ctx)) {
      ctx.checkAborted('ok');
      okIdx = ctx.addExecution('ok');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'ok';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink' }, ok_execute);
        const ok_value = await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx! }) as number;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink' }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    } else {
      okIdx = ctx.addExecution('ok');
    }
  } else {
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: regular-branch-scoped-output 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  if (await __ctrl__.beforeNode('b', ctx)) {

    // ── b (regScoped) ──
    ctx.checkAborted('b');
    bIdx = ctx.addExecution('b');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'b';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'regScoped',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'regScoped' }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'regScoped' }, b_value);
      const b_body_scopeFn = ((ctx) => {
      return (scopedOut: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('b', bIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_scopedOut = scopedCtx.addExecution('b_param_scopedOut');
        scopedCtx.setVariable({ id: 'b', portName: 'scopedOut', executionIndex: scopeParamIdx_scopedOut, nodeTypeName: 'regScoped', scope: 'body', side: 'start' }, scopedOut);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('b_scope_exit');
        return {  };
      };
    })(ctx);
      const bResult = regScoped(b_execute, b_value, b_body_scopeFn);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScoped',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
