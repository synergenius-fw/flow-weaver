exports[`branching codegen golden (debt #2) > dev-mode output is stable: async-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  if (await __ctrl__.beforeNode('b', ctx)) {

    // ── b (brAsync) ──
    ctx.checkAborted('b');
    bIdx = ctx.addExecution('b');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'b';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brAsync',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'brAsync' }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'brAsync' }, b_value);
      const bResult = await brAsync(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brAsync',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brAsync',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brAsync',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'brAsync' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    bIdx = ctx.addExecution('b');
    b_success = true;
  }

  if (b_success) {
    if (await __ctrl__.beforeNode('ok', ctx)) {
      ctx.checkAborted('ok');
      okIdx = ctx.addExecution('ok');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'ok';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink' }, ok_execute);
        const ok_value = await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx! }) as number;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink' }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    } else {
      okIdx = ctx.addExecution('ok');
    }
  } else {
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: async-map-iterator-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let mbIdx: number | undefined;
  let mhIdx: number | undefined;
  let mb_success = false;

  if (await __ctrl__.beforeNode('mb', ctx)) {

    // ── mb (asyncMapBranch) ──
    ctx.checkAborted('mb');
    mbIdx = ctx.addExecution('mb');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'mb';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'asyncMapBranch',
      id: 'mb',
      executionIndex: mbIdx,
      status: 'RUNNING',
    });

    mb_success = false;

    try {
      const mb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'mb', portName: 'execute', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mb_execute);
      const mb_items = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as unknown[];
      await ctx.setVariable({ id: 'mb', portName: 'items', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mb_items);
      const mb_body_scopeFn = ((ctx) => {
      return async (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('mb', mbIdx!, 'body', true);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('mb_param_item');
        await scopedCtx.setVariable({ id: 'mb', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'asyncMapBranch', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('mb_scope_exit');
        return {  };
      };
    })(ctx);
      let mbResult: { onSuccess: boolean; onFailure: boolean; results: unknown[] };
      if (!mb_execute) {
        mbResult = { onSuccess: false, onFailure: false, results: [] };
      } else {
        const __results: unknown[] = [];
        for (const __item of mb_items) {
          __results.push((await mb_body_scopeFn(true, __item)).processed);
        }
        mbResult = { onSuccess: true, onFailure: false, results: __results };
      }
      await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.onSuccess);
      await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.onFailure);
      await ctx.setVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.results);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('mb', ctx);
      mb_success = mbResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'asyncMapBranch',
          id: 'mb',
          executionIndex: mbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, false);
        await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, true);
        mb_success = false;
      }
      const mhIdx = ctx.addExecution('mh');
      await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
      await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    mbIdx = ctx.addExecution('mb');
    mb_success = true;
  }

  if (mb_success) {
    if (await __ctrl__.beforeNode('mh', ctx)) {
      ctx.checkAborted('mh');
      mhIdx = ctx.addExecution('mh');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'mh';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'RUNNING',
      });
      try {
        const mh_execute = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx }) as boolean : false;
        await ctx.setVariable({ id: 'mh', portName: 'execute', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mh_execute);
        const mh_value = await ctx.getVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx! }) as number;
        await ctx.setVariable({ id: 'mh', portName: 'value', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mh_value);
        const mhResult = asyncMapSink(mh_execute, mh_value);
        await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.onSuccess);
        await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.onFailure);
        await ctx.setVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'asyncMapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('mh', ctx);
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'asyncMapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'asyncMapSink',
            id: 'mh',
            executionIndex: mhIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    } else {
      mhIdx = ctx.addExecution('mh');
    }
  } else {
    const mhIdx = ctx.addExecution('mh');
    await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
    await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'asyncMapSink',
      id: 'mh',
      executionIndex: mhIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = mhIdx !== undefined ? await ctx.getVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: chained-branches 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let aIdx: number | undefined;
  let bbIdx: number | undefined;
  let okIdx: number | undefined;
  let a_success = false;
  let bb_success = false;


  if (await __ctrl__.beforeNode('a', ctx)) {

    // ── a (brA) ──
    ctx.checkAborted('a');
    aIdx = ctx.addExecution('a');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'a';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brA',
      id: 'a',
      executionIndex: aIdx,
      status: 'RUNNING',
    });

    a_success = false;

    try {
      const a_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'a', portName: 'execute', executionIndex: aIdx, nodeTypeName: 'brA' }, a_execute);
      const a_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'a', portName: 'value', executionIndex: aIdx, nodeTypeName: 'brA' }, a_value);
      const aResult = brA(a_execute, a_value);
      await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onSuccess);
      await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onFailure);
      await ctx.setVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('a', ctx);
      a_success = aResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brA',
          id: 'a',
          executionIndex: aIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, false);
        await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, true);
        a_success = false;
      }
      throw error;
    }
  } else {
    aIdx = ctx.addExecution('a');
    a_success = true;
  }

  if (a_success) {
    if (await __ctrl__.beforeNode('bb', ctx)) {

      // ── bb (brB) ──
      ctx.checkAborted('bb');
      bbIdx = ctx.addExecution('bb');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'bb';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: 'RUNNING',
      });

      bb_success = false;

      try {
        const bb_execute = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx }) as boolean : false;
        await ctx.setVariable({ id: 'bb', portName: 'execute', executionIndex: bbIdx, nodeTypeName: 'brB' }, bb_execute);
        const bb_value = await ctx.getVariable({ id: 'a', portName: 'result', executionIndex: aIdx! }) as number;
        await ctx.setVariable({ id: 'bb', portName: 'value', executionIndex: bbIdx, nodeTypeName: 'brB' }, bb_value);
        const bbResult = brB(bb_execute, bb_value);
        await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onSuccess);
        await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onFailure);
        await ctx.setVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.result);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('bb', ctx);
        bb_success = bbResult.onSuccess;
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'brB',
            id: 'bb',
            executionIndex: bbIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
          await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
          await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, true);
          bb_success = false;
        }
        const okIdx = ctx.addExecution('ok');
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'CANCELLED',
        });
        throw error;
      }
    } else {
      bbIdx = ctx.addExecution('bb');
      bb_success = true;
    }

    if (bb_success) {
      if (await __ctrl__.beforeNode('ok', ctx)) {
        ctx.checkAborted('ok');
        okIdx = ctx.addExecution('ok');
        if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'ok';
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'RUNNING',
        });
        try {
          const ok_execute = bbIdx !== undefined ? await ctx.getVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx }) as boolean : false;
          await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink' }, ok_execute);
          const ok_value = await ctx.getVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx! }) as number;
          await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink' }, ok_value);
          const okResult = okSink(ok_execute, ok_value);
          await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
          await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
          await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
          await ctx.sendStatusChangedEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            status: 'SUCCEEDED',
          });
          await __ctrl__.afterNode('ok', ctx);
        } catch (error: unknown) {
          const isCancellation = CancellationError.isCancellationError(error);
          await ctx.sendStatusChangedEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            status: isCancellation ? 'CANCELLED' : 'FAILED',
          });
          if (!isCancellation) {
            ctx.sendLogErrorEvent({
              nodeTypeName: 'okSink',
              id: 'ok',
              executionIndex: okIdx,
              error: error instanceof Error ? error.message : String(error),
              code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
            });
          }
          throw error;
        }
      } else {
        okIdx = ctx.addExecution('ok');
      }
    } else {
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
    }
  } else {
    const bbIdx = ctx.addExecution('bb');
    await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
    await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brB',
      id: 'bb',
      executionIndex: bbIdx,
      status: 'CANCELLED',
    });
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: expression-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let chkIdx: number | undefined;
  let hIdx: number | undefined;
  let chk_success = false;

  if (await __ctrl__.beforeNode('chk', ctx)) {

    // ── chk (checkValue) ──
    ctx.checkAborted('chk');
    chkIdx = ctx.addExecution('chk');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'chk';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'checkValue',
      id: 'chk',
      executionIndex: chkIdx,
      status: 'RUNNING',
    });

    chk_success = false;

    try {
      await ctx.setVariable({ id: 'chk', portName: 'execute', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
      const chk_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'chk', portName: 'value', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, chk_value);
      const chkResult = checkValue(chk_value);
      const chkResult_raw: unknown = chkResult;
      await ctx.setVariable({ id: 'chk', portName: 'result', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, typeof chkResult_raw === 'object' && chkResult_raw !== null && 'result' in chkResult_raw ? chkResult_raw.result : chkResult_raw);
      await ctx.setVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
      await ctx.setVariable({ id: 'chk', portName: 'onFailure', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'checkValue',
        id: 'chk',
        executionIndex: chkIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('chk', ctx);
      chk_success = true;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'checkValue',
        id: 'chk',
        executionIndex: chkIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'checkValue',
          id: 'chk',
          executionIndex: chkIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, false);
        await ctx.setVariable({ id: 'chk', portName: 'onFailure', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
        chk_success = false;
      }
      const hIdx = ctx.addExecution('h');
      await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
      await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'handler',
        id: 'h',
        executionIndex: hIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    chkIdx = ctx.addExecution('chk');
    chk_success = true;
  }

  if (chk_success) {
    if (await __ctrl__.beforeNode('h', ctx)) {
      ctx.checkAborted('h');
      hIdx = ctx.addExecution('h');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'h';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'handler',
        id: 'h',
        executionIndex: hIdx,
        status: 'RUNNING',
      });
      try {
        const h_execute = chkIdx !== undefined ? await ctx.getVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx }) as boolean : false;
        await ctx.setVariable({ id: 'h', portName: 'execute', executionIndex: hIdx, nodeTypeName: 'handler' }, h_execute);
        let h_value: number = undefined as unknown as number; // Required port 'value' has no connection
        await ctx.setVariable({ id: 'h', portName: 'value', executionIndex: hIdx, nodeTypeName: 'handler' }, h_value);
        const hResult = handler(h_execute, h_value);
        await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.onSuccess);
        await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.onFailure);
        await ctx.setVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'handler',
          id: 'h',
          executionIndex: hIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('h', ctx);
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'handler',
          id: 'h',
          executionIndex: hIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'handler',
            id: 'h',
            executionIndex: hIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    } else {
      hIdx = ctx.addExecution('h');
    }
  } else {
    const hIdx = ctx.addExecution('h');
    await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
    await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'handler',
      id: 'h',
      executionIndex: hIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = hIdx !== undefined ? await ctx.getVariable({ id: 'h', portName: 'out', executionIndex: hIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: expression-branch-extra-ports 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let exIdx: number | undefined;
  let hIdx: number | undefined;
  let ex_success = false;

  if (await __ctrl__.beforeNode('ex', ctx)) {

    // ── ex (exprExtra) ──
    ctx.checkAborted('ex');
    exIdx = ctx.addExecution('ex');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'ex';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'exprExtra',
      id: 'ex',
      executionIndex: exIdx,
      status: 'RUNNING',
    });

    ex_success = false;

    try {
      await ctx.setVariable({ id: 'ex', portName: 'execute', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, true);
      const ex_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'ex', portName: 'value', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, ex_value);
      const ex_body_scopeFn = ((ctx) => {
      return (scopedOut: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('ex', exIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_scopedOut = scopedCtx.addExecution('ex_param_scopedOut');
        scopedCtx.setVariable({ id: 'ex', portName: 'scopedOut', executionIndex: scopeParamIdx_scopedOut, nodeTypeName: 'exprExtra', scope: 'body', side: 'start' }, scopedOut);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('ex_scope_exit');
        return {  };
      };
    })(ctx);
      const exResult = exprExtra(ex_value, ex_body_scopeFn);
      await ctx.setVariable({ id: 'ex', portName: 'low', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, exResult.low);
      await ctx.setVariable({ id: 'ex', portName: 'high', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, exResult.high);
      await ctx.setVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, true);
      await ctx.setVariable({ id: 'ex', portName: 'onFailure', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtra',
        id: 'ex',
        executionIndex: exIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('ex', ctx);
      ex_success = true;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtra',
        id: 'ex',
        executionIndex: exIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'exprExtra',
          id: 'ex',
          executionIndex: exIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, false);
        await ctx.setVariable({ id: 'ex', portName: 'onFailure', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, true);
        ex_success = false;
      }
      const hIdx = ctx.addExecution('h');
      await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
      await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtraSink',
        id: 'h',
        executionIndex: hIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    exIdx = ctx.addExecution('ex');
    ex_success = true;
  }

  if (ex_success) {
    if (await __ctrl__.beforeNode('h', ctx)) {
      ctx.checkAborted('h');
      hIdx = ctx.addExecution('h');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'h';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtraSink',
        id: 'h',
        executionIndex: hIdx,
        status: 'RUNNING',
      });
      try {
        const h_execute = exIdx !== undefined ? await ctx.getVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx }) as boolean : false;
        await ctx.setVariable({ id: 'h', portName: 'execute', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, h_execute);
        const h_value = await ctx.getVariable({ id: 'ex', portName: 'low', executionIndex: exIdx! }) as number;
        await ctx.setVariable({ id: 'h', portName: 'value', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, h_value);
        const hResult = exprExtraSink(h_execute, h_value);
        await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.onSuccess);
        await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.onFailure);
        await ctx.setVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'exprExtraSink',
          id: 'h',
          executionIndex: hIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('h', ctx);
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'exprExtraSink',
          id: 'h',
          executionIndex: hIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'exprExtraSink',
            id: 'h',
            executionIndex: hIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    } else {
      hIdx = ctx.addExecution('h');
    }
  } else {
    const hIdx = ctx.addExecution('h');
    await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
    await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'exprExtraSink',
      id: 'h',
      executionIndex: hIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = hIdx !== undefined ? await ctx.getVariable({ id: 'h', portName: 'out', executionIndex: hIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: fan-out-two-branches 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let aIdx: number | undefined;
  let okIdx: number | undefined;
  let a_success = false;

  if (await __ctrl__.beforeNode('a', ctx)) {

    // ── a (brA) ──
    ctx.checkAborted('a');
    aIdx = ctx.addExecution('a');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'a';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brA',
      id: 'a',
      executionIndex: aIdx,
      status: 'RUNNING',
    });

    a_success = false;

    try {
      const a_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'a', portName: 'execute', executionIndex: aIdx, nodeTypeName: 'brA' }, a_execute);
      const a_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'a', portName: 'value', executionIndex: aIdx, nodeTypeName: 'brA' }, a_value);
      const aResult = brA(a_execute, a_value);
      await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onSuccess);
      await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onFailure);
      await ctx.setVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('a', ctx);
      a_success = aResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brA',
          id: 'a',
          executionIndex: aIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, false);
        await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, true);
        a_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    aIdx = ctx.addExecution('a');
    a_success = true;
  }

  if (a_success) {
    if (await __ctrl__.beforeNode('ok', ctx)) {
      ctx.checkAborted('ok');
      okIdx = ctx.addExecution('ok');
      if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'ok';
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink' }, ok_execute);
        const ok_value = await ctx.getVariable({ id: 'a', portName: 'result', executionIndex: aIdx! }) as number;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink' }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    } else {
      okIdx = ctx.addExecution('ok');
    }
  } else {
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
  }
  let bbIdx: number;
  if (await __ctrl__.beforeNode('bb', ctx)) {
    ctx.checkAborted('bb');
    bbIdx = ctx.addExecution('bb');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'bb';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brB',
      id: 'bb',
      executionIndex: bbIdx,
      status: 'RUNNING',
    });
    try {
      const bb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'bb', portName: 'execute', executionIndex: bbIdx, nodeTypeName: 'brB' }, bb_execute);
      const bb_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as number;
      await ctx.setVariable({ id: 'bb', portName: 'value', executionIndex: bbIdx, nodeTypeName: 'brB' }, bb_value);
      const bbResult = brB(bb_execute, bb_value);
      await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onSuccess);
      await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onFailure);
      await ctx.setVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('bb', ctx);
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
      }
      throw error;
    }
  } else {
    bbIdx = ctx.addExecution('bb');
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: map-iterator-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

declare const __flowWeaverDebugger__: TDebugger | undefined;

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<boolean> | boolean;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

declare const __abortSignal__: AbortSignal | undefined;

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private abortSignal?: AbortSignal | undefined;

  constructor(isAsync: boolean = true, flowWeaverDebugger?: TDebugger, abortSignal?: AbortSignal) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = flowWeaverDebugger;
    this.abortSignal = abortSignal;
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    if (!this.variables.has(key)) {
      throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
    }
    const value = this.variables.get(key);
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key);
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, this.flowWeaverDebugger, this.abortSignal);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  serialize(): {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  } {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      if (typeof value === "function") {
        try { vars[key] = (value as () => unknown)(); } catch { vars[key] = value; }
      } else {
        vars[key] = value;
      }
    }
    const execs: Record<string, ExecutionInfo> = {};
    for (const [key, info] of this.executions) { execs[key] = { ...info }; }
    const nodeCounts: Record<string, number> = {};
    for (const [key, count] of this.nodeExecutionIndices) { nodeCounts[key] = count; }
    return { variables: vars, executions: execs, executionCounter: this.executionCounter, nodeExecutionCounts: nodeCounts };
  }

  restore(data: {
    variables: Record<string, unknown>;
    executions: Record<string, ExecutionInfo>;
    executionCounter: number;
    nodeExecutionCounts: Record<string, number>;
  }): void {
    this.variables = new Map(Object.entries(data.variables));
    this.executions = new Map(Object.entries(data.executions));
    this.executionCounter = data.executionCounter;
    this.nodeExecutionIndices = new Map(Object.entries(data.nodeExecutionCounts));
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __flowWeaverDebugger__?: TDebugger,
  __abortSignal__?: AbortSignal
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  const __effectiveDebugger__ = typeof __flowWeaverDebugger__ !== 'undefined' ? __flowWeaverDebugger__ : undefined;

  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __effectiveDebugger__, __abortSignal__);

  // Debug controller for step-through debugging and checkpoint/resume
  const __ctrl__: TDebugController = (
    typeof globalThis !== 'undefined' && (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      ? (globalThis as unknown as { __fw_debug_controller__?: TDebugController }).__fw_debug_controller__
      : { beforeNode: () => true, afterNode: () => {} }
  )!;

  const startIdx = ctx.addExecution('Start');
  await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
  await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Start',
    id: 'Start',
    executionIndex: startIdx,
    status: 'SUCCEEDED',
  });

  let mbIdx: number | undefined;
  let mhIdx: number | undefined;
  let mb_success = false;

  if (await __ctrl__.beforeNode('mb', ctx)) {

    // ── mb (mapBranch) ──
    ctx.checkAborted('mb');
    mbIdx = ctx.addExecution('mb');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'mb';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'mapBranch',
      id: 'mb',
      executionIndex: mbIdx,
      status: 'RUNNING',
    });

    mb_success = false;

    try {
      const mb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx }) as boolean;
      await ctx.setVariable({ id: 'mb', portName: 'execute', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mb_execute);
      const mb_items = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx }) as unknown[];
      await ctx.setVariable({ id: 'mb', portName: 'items', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mb_items);
      const mb_body_scopeFn = ((ctx) => {
      return (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('mb', mbIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('mb_param_item');
        scopedCtx.setVariable({ id: 'mb', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'mapBranch', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('mb_scope_exit');
        return {  };
      };
    })(ctx);
      let mbResult: { onSuccess: boolean; onFailure: boolean; results: unknown[] };
      if (!mb_execute) {
        mbResult = { onSuccess: false, onFailure: false, results: [] };
      } else {
        const __results: unknown[] = [];
        for (const __item of mb_items) {
          __results.push((await mb_body_scopeFn(true, __item)).processed);
        }
        mbResult = { onSuccess: true, onFailure: false, results: __results };
      }
      await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.onSuccess);
      await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.onFailure);
      await ctx.setVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.results);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: 'SUCCEEDED',
      });
      await __ctrl__.afterNode('mb', ctx);
      mb_success = mbResult.onSuccess;
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
