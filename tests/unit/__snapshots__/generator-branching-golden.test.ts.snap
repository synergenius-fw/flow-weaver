      return (scopedOut: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('b', bIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_scopedOut = scopedCtx.addExecution('b_param_scopedOut');
        scopedCtx.setVariable({ id: 'b', portName: 'scopedOut', executionIndex: scopeParamIdx_scopedOut, nodeTypeName: 'subWf', scope: 'body', side: 'start' }, scopedOut);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('b_scope_exit');
        return {  };
      };
    })(ctx);
      const __bParams__ = { value: b_value, __rd__: __rd__ + 1 };
      const bResult = subWf(b_execute, __bParams__, ctx.createNestedRuntime('subWf', 'b', bIdx));
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'subWf' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'subWf' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'subWf' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'subWf',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'subWf', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'subWf',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'subWf',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'subWf' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'subWf' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
