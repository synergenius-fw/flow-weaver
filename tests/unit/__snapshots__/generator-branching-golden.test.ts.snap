// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`branching codegen golden (debt #2) > dev-mode output is stable: async-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (brAsync) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'brAsync', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brAsync',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'brAsync', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'brAsync', durable: false }, b_value);
      const bResult = await brAsync(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'brAsync' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brAsync',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'brAsync', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brAsync',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brAsync',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'brAsync' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'brAsync' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: async-map-iterator-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let mbIdx: number | undefined;
  let mhIdx: number | undefined;
  let mb_success = false;

  await __ctrl__.beforeNode('mb', ctx);

  // ── mb (asyncMapBranch) ──
  ctx.checkAborted('mb');
  mbIdx = ctx.addExecution('mb');
  if (ctx.shouldExecute('mb', 'asyncMapBranch', mbIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'asyncMapBranch',
      id: 'mb',
      executionIndex: mbIdx,
      status: 'RUNNING',
    });

    mb_success = false;

    try {
      const mb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'mb', portName: 'execute', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch', durable: false }, mb_execute);
      const mb_items = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as unknown[];
      await ctx.setVariable({ id: 'mb', portName: 'items', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch', durable: false }, mb_items);
      const mb_body_scopeFn = ((ctx) => {
      return async (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('mb', mbIdx!, 'body', true);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('mb_param_item');
        await scopedCtx.setVariable({ id: 'mb', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'asyncMapBranch', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('mb_scope_exit');
        return {  };
      };
    })(ctx);
      let mbResult: { onSuccess: boolean; onFailure: boolean; results: unknown[] };
      if (!mb_execute) {
        mbResult = { onSuccess: false, onFailure: false, results: [] };
      } else {
        const __results: unknown[] = [];
        for (const __item of mb_items) {
          __results.push((await mb_body_scopeFn(true, __item)).processed);
        }
        mbResult = { onSuccess: true, onFailure: false, results: __results };
      }
      await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.onSuccess);
      await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.onFailure);
      await ctx.setVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, mbResult.results);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('mb', 'asyncMapBranch', mbIdx);
      await __ctrl__.afterNode('mb', ctx);
      mb_success = mbResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'asyncMapBranch',
          id: 'mb',
          executionIndex: mbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, false);
        await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }, true);
        mb_success = false;
      }
      const mhIdx = ctx.addExecution('mh');
      await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
      await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    mb_success = await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as boolean;
  }

  if (mb_success) {
    ctx.enterBranch('mb', mbIdx, 'success');
    await __ctrl__.beforeNode('mh', ctx);
    ctx.checkAborted('mh');
    mhIdx = ctx.addExecution('mh');
    if (ctx.shouldExecute('mh', 'asyncMapSink', mhIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'asyncMapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'RUNNING',
      });
      try {
        const mh_execute = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as boolean : false;
        await ctx.setVariable({ id: 'mh', portName: 'execute', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink', durable: false }, mh_execute);
        const mh_value = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'asyncMapBranch' }) as number : undefined;
        await ctx.setVariable({ id: 'mh', portName: 'value', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink', durable: false }, mh_value);
        const mhResult = asyncMapSink(mh_execute, mh_value);
        await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.onSuccess);
        await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.onFailure);
        await ctx.setVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, mhResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'asyncMapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('mh', 'asyncMapSink', mhIdx);
        await __ctrl__.afterNode('mh', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'asyncMapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'asyncMapSink',
            id: 'mh',
            executionIndex: mhIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('mb', mbIdx, 'failure');
    const mhIdx = ctx.addExecution('mh');
    await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
    await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'asyncMapSink',
      id: 'mh',
      executionIndex: mhIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = mhIdx !== undefined ? await ctx.getVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'asyncMapSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: chained-branches 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let aIdx: number | undefined;
  let bbIdx: number | undefined;
  let okIdx: number | undefined;
  let a_success = false;
  let bb_success = false;


  await __ctrl__.beforeNode('a', ctx);

  // ── a (brA) ──
  ctx.checkAborted('a');
  aIdx = ctx.addExecution('a');
  if (ctx.shouldExecute('a', 'brA', aIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brA',
      id: 'a',
      executionIndex: aIdx,
      status: 'RUNNING',
    });

    a_success = false;

    try {
      const a_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'a', portName: 'execute', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_execute);
      const a_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'a', portName: 'value', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_value);
      const aResult = brA(a_execute, a_value);
      await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onSuccess);
      await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onFailure);
      await ctx.setVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('a', 'brA', aIdx);
      await __ctrl__.afterNode('a', ctx);
      a_success = aResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brA',
          id: 'a',
          executionIndex: aIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, false);
        await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, true);
        a_success = false;
      }
      throw error;
    }
  } else {
    a_success = await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean;
  }

  if (a_success) {
    await __ctrl__.beforeNode('bb', ctx);

    // ── bb (brB) ──
    ctx.checkAborted('bb');
    bbIdx = ctx.addExecution('bb');
    if (ctx.shouldExecute('bb', 'brB', bbIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: 'RUNNING',
      });

      bb_success = false;

      try {
        const bb_execute = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean : false;
        await ctx.setVariable({ id: 'bb', portName: 'execute', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_execute);
        const bb_value = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }) as number : undefined;
        await ctx.setVariable({ id: 'bb', portName: 'value', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_value);
        const bbResult = brB(bb_execute, bb_value);
        await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onSuccess);
        await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onFailure);
        await ctx.setVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.result);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('bb', 'brB', bbIdx);
        await __ctrl__.afterNode('bb', ctx);
        bb_success = bbResult.onSuccess;
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'brB',
            id: 'bb',
            executionIndex: bbIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
          await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
          await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, true);
          bb_success = false;
        }
        const okIdx = ctx.addExecution('ok');
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'CANCELLED',
        });
        throw error;
      }
    } else {
      bb_success = await ctx.getVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }) as boolean;
    }

    if (bb_success) {
      ctx.enterBranch('bb', bbIdx, 'success');
      await __ctrl__.beforeNode('ok', ctx);
      ctx.checkAborted('ok');
      okIdx = ctx.addExecution('ok');
      if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'RUNNING',
        });
        try {
          const ok_execute = bbIdx !== undefined ? await ctx.getVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }) as boolean : false;
          await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
          const ok_value = bbIdx !== undefined ? await ctx.getVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }) as number : undefined;
          await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
          const okResult = okSink(ok_execute, ok_value);
          await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
          await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
          await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
          await ctx.sendStatusChangedEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            status: 'SUCCEEDED',
          });
          ctx.commitNode('ok', 'okSink', okIdx);
          await __ctrl__.afterNode('ok', ctx);
        } catch (error: unknown) {
          if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
          const isCancellation = CancellationError.isCancellationError(error);
          await ctx.sendStatusChangedEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            status: isCancellation ? 'CANCELLED' : 'FAILED',
          });
          if (!isCancellation) {
            ctx.sendLogErrorEvent({
              nodeTypeName: 'okSink',
              id: 'ok',
              executionIndex: okIdx,
              error: error instanceof Error ? error.message : String(error),
              code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
            });
          }
          throw error;
        }
      }
      ctx.exitBranch();
    } else {
      ctx.enterBranch('bb', bbIdx, 'failure');
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      ctx.exitBranch();
    }
  } else {
    const bbIdx = ctx.addExecution('bb');
    await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
    await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brB',
      id: 'bb',
      executionIndex: bbIdx,
      status: 'CANCELLED',
    });
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: expression-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let chkIdx: number | undefined;
  let hIdx: number | undefined;
  let chk_success = false;

  await __ctrl__.beforeNode('chk', ctx);

  // ── chk (checkValue) ──
  ctx.checkAborted('chk');
  chkIdx = ctx.addExecution('chk');
  if (ctx.shouldExecute('chk', 'checkValue', chkIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'checkValue',
      id: 'chk',
      executionIndex: chkIdx,
      status: 'RUNNING',
    });

    chk_success = false;

    try {
      await ctx.setVariable({ id: 'chk', portName: 'execute', executionIndex: chkIdx, nodeTypeName: 'checkValue', durable: false }, true);
      const chk_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'chk', portName: 'value', executionIndex: chkIdx, nodeTypeName: 'checkValue', durable: false }, chk_value);
      const chkResult = checkValue(chk_value);
      const chkResult_raw: unknown = chkResult;
      await ctx.setVariable({ id: 'chk', portName: 'result', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, typeof chkResult_raw === 'object' && chkResult_raw !== null && 'result' in chkResult_raw ? chkResult_raw.result : chkResult_raw);
      await ctx.setVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
      await ctx.setVariable({ id: 'chk', portName: 'onFailure', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'checkValue',
        id: 'chk',
        executionIndex: chkIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('chk', 'checkValue', chkIdx);
      await __ctrl__.afterNode('chk', ctx);
      chk_success = true;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'checkValue',
        id: 'chk',
        executionIndex: chkIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'checkValue',
          id: 'chk',
          executionIndex: chkIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, false);
        await ctx.setVariable({ id: 'chk', portName: 'onFailure', executionIndex: chkIdx, nodeTypeName: 'checkValue' }, true);
        chk_success = false;
      }
      const hIdx = ctx.addExecution('h');
      await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
      await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'handler',
        id: 'h',
        executionIndex: hIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    chk_success = await ctx.getVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }) as boolean;
  }

  if (chk_success) {
    ctx.enterBranch('chk', chkIdx, 'success');
    await __ctrl__.beforeNode('h', ctx);
    ctx.checkAborted('h');
    hIdx = ctx.addExecution('h');
    if (ctx.shouldExecute('h', 'handler', hIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'handler',
        id: 'h',
        executionIndex: hIdx,
        status: 'RUNNING',
      });
      try {
        const h_execute = chkIdx !== undefined ? await ctx.getVariable({ id: 'chk', portName: 'onSuccess', executionIndex: chkIdx, nodeTypeName: 'checkValue' }) as boolean : false;
        await ctx.setVariable({ id: 'h', portName: 'execute', executionIndex: hIdx, nodeTypeName: 'handler', durable: false }, h_execute);
        let h_value: number = undefined as unknown as number; // Required port 'value' has no connection
        await ctx.setVariable({ id: 'h', portName: 'value', executionIndex: hIdx, nodeTypeName: 'handler', durable: false }, h_value);
        const hResult = handler(h_execute, h_value);
        await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.onSuccess);
        await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.onFailure);
        await ctx.setVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'handler' }, hResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'handler',
          id: 'h',
          executionIndex: hIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('h', 'handler', hIdx);
        await __ctrl__.afterNode('h', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'handler',
          id: 'h',
          executionIndex: hIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'handler',
            id: 'h',
            executionIndex: hIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('chk', chkIdx, 'failure');
    const hIdx = ctx.addExecution('h');
    await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
    await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'handler' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'handler',
      id: 'h',
      executionIndex: hIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = hIdx !== undefined ? await ctx.getVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'handler' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: expression-branch-extra-ports 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let exIdx: number | undefined;
  let hIdx: number | undefined;
  let ex_success = false;

  await __ctrl__.beforeNode('ex', ctx);

  // ── ex (exprExtra) ──
  ctx.checkAborted('ex');
  exIdx = ctx.addExecution('ex');
  if (ctx.shouldExecute('ex', 'exprExtra', exIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'exprExtra',
      id: 'ex',
      executionIndex: exIdx,
      status: 'RUNNING',
    });

    ex_success = false;

    try {
      await ctx.setVariable({ id: 'ex', portName: 'execute', executionIndex: exIdx, nodeTypeName: 'exprExtra', durable: false }, true);
      const ex_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'ex', portName: 'value', executionIndex: exIdx, nodeTypeName: 'exprExtra', durable: false }, ex_value);
      const ex_body_scopeFn = ((ctx) => {
      return (scopedOut: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('ex', exIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_scopedOut = scopedCtx.addExecution('ex_param_scopedOut');
        scopedCtx.setVariable({ id: 'ex', portName: 'scopedOut', executionIndex: scopeParamIdx_scopedOut, nodeTypeName: 'exprExtra', scope: 'body', side: 'start' }, scopedOut);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('ex_scope_exit');
        return {  };
      };
    })(ctx);
      const exResult = exprExtra(ex_value, ex_body_scopeFn);
      await ctx.setVariable({ id: 'ex', portName: 'low', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, exResult.low);
      await ctx.setVariable({ id: 'ex', portName: 'high', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, exResult.high);
      await ctx.setVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, true);
      await ctx.setVariable({ id: 'ex', portName: 'onFailure', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtra',
        id: 'ex',
        executionIndex: exIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('ex', 'exprExtra', exIdx);
      await __ctrl__.afterNode('ex', ctx);
      ex_success = true;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtra',
        id: 'ex',
        executionIndex: exIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'exprExtra',
          id: 'ex',
          executionIndex: exIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, false);
        await ctx.setVariable({ id: 'ex', portName: 'onFailure', executionIndex: exIdx, nodeTypeName: 'exprExtra' }, true);
        ex_success = false;
      }
      const hIdx = ctx.addExecution('h');
      await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
      await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtraSink',
        id: 'h',
        executionIndex: hIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    ex_success = await ctx.getVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }) as boolean;
  }

  if (ex_success) {
    ctx.enterBranch('ex', exIdx, 'success');
    await __ctrl__.beforeNode('h', ctx);
    ctx.checkAborted('h');
    hIdx = ctx.addExecution('h');
    if (ctx.shouldExecute('h', 'exprExtraSink', hIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'exprExtraSink',
        id: 'h',
        executionIndex: hIdx,
        status: 'RUNNING',
      });
      try {
        const h_execute = exIdx !== undefined ? await ctx.getVariable({ id: 'ex', portName: 'onSuccess', executionIndex: exIdx, nodeTypeName: 'exprExtra' }) as boolean : false;
        await ctx.setVariable({ id: 'h', portName: 'execute', executionIndex: hIdx, nodeTypeName: 'exprExtraSink', durable: false }, h_execute);
        const h_value = exIdx !== undefined ? await ctx.getVariable({ id: 'ex', portName: 'low', executionIndex: exIdx, nodeTypeName: 'exprExtra' }) as number : undefined;
        await ctx.setVariable({ id: 'h', portName: 'value', executionIndex: hIdx, nodeTypeName: 'exprExtraSink', durable: false }, h_value);
        const hResult = exprExtraSink(h_execute, h_value);
        await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.onSuccess);
        await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.onFailure);
        await ctx.setVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, hResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'exprExtraSink',
          id: 'h',
          executionIndex: hIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('h', 'exprExtraSink', hIdx);
        await __ctrl__.afterNode('h', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'exprExtraSink',
          id: 'h',
          executionIndex: hIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'exprExtraSink',
            id: 'h',
            executionIndex: hIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('ex', exIdx, 'failure');
    const hIdx = ctx.addExecution('h');
    await ctx.setVariable({ id: 'h', portName: 'onSuccess', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
    await ctx.setVariable({ id: 'h', portName: 'onFailure', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'exprExtraSink',
      id: 'h',
      executionIndex: hIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = hIdx !== undefined ? await ctx.getVariable({ id: 'h', portName: 'out', executionIndex: hIdx, nodeTypeName: 'exprExtraSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: fan-out-two-branches 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let aIdx: number | undefined;
  let okIdx: number | undefined;
  let a_success = false;

  await __ctrl__.beforeNode('a', ctx);

  // ── a (brA) ──
  ctx.checkAborted('a');
  aIdx = ctx.addExecution('a');
  if (ctx.shouldExecute('a', 'brA', aIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brA',
      id: 'a',
      executionIndex: aIdx,
      status: 'RUNNING',
    });

    a_success = false;

    try {
      const a_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'a', portName: 'execute', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_execute);
      const a_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'a', portName: 'value', executionIndex: aIdx, nodeTypeName: 'brA', durable: false }, a_value);
      const aResult = brA(a_execute, a_value);
      await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onSuccess);
      await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.onFailure);
      await ctx.setVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }, aResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('a', 'brA', aIdx);
      await __ctrl__.afterNode('a', ctx);
      a_success = aResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brA',
        id: 'a',
        executionIndex: aIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brA',
          id: 'a',
          executionIndex: aIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }, false);
        await ctx.setVariable({ id: 'a', portName: 'onFailure', executionIndex: aIdx, nodeTypeName: 'brA' }, true);
        a_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    a_success = await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean;
  }

  if (a_success) {
    ctx.enterBranch('a', aIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'onSuccess', executionIndex: aIdx, nodeTypeName: 'brA' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = aIdx !== undefined ? await ctx.getVariable({ id: 'a', portName: 'result', executionIndex: aIdx, nodeTypeName: 'brA' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('a', aIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  await __ctrl__.beforeNode('bb', ctx);
  ctx.checkAborted('bb');
  const bbIdx = ctx.addExecution('bb');
  if (ctx.shouldExecute('bb', 'brB', bbIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'brB',
      id: 'bb',
      executionIndex: bbIdx,
      status: 'RUNNING',
    });
    try {
      const bb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'bb', portName: 'execute', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_execute);
      const bb_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'bb', portName: 'value', executionIndex: bbIdx, nodeTypeName: 'brB', durable: false }, bb_value);
      const bbResult = brB(bb_execute, bb_value);
      await ctx.setVariable({ id: 'bb', portName: 'onSuccess', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onSuccess);
      await ctx.setVariable({ id: 'bb', portName: 'onFailure', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.onFailure);
      await ctx.setVariable({ id: 'bb', portName: 'result', executionIndex: bbIdx, nodeTypeName: 'brB' }, bbResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('bb', 'brB', bbIdx);
      await __ctrl__.afterNode('bb', ctx);
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'brB',
        id: 'bb',
        executionIndex: bbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'brB',
          id: 'bb',
          executionIndex: bbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
      }
      throw error;
    }
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: map-iterator-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let mbIdx: number | undefined;
  let mhIdx: number | undefined;
  let mb_success = false;

  await __ctrl__.beforeNode('mb', ctx);

  // ── mb (mapBranch) ──
  ctx.checkAborted('mb');
  mbIdx = ctx.addExecution('mb');
  if (ctx.shouldExecute('mb', 'mapBranch', mbIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'mapBranch',
      id: 'mb',
      executionIndex: mbIdx,
      status: 'RUNNING',
    });

    mb_success = false;

    try {
      const mb_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'mb', portName: 'execute', executionIndex: mbIdx, nodeTypeName: 'mapBranch', durable: false }, mb_execute);
      const mb_items = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as unknown[];
      await ctx.setVariable({ id: 'mb', portName: 'items', executionIndex: mbIdx, nodeTypeName: 'mapBranch', durable: false }, mb_items);
      const mb_body_scopeFn = ((ctx) => {
      return (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('mb', mbIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('mb_param_item');
        scopedCtx.setVariable({ id: 'mb', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'mapBranch', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('mb_scope_exit');
        return {  };
      };
    })(ctx);
      let mbResult: { onSuccess: boolean; onFailure: boolean; results: unknown[] };
      if (!mb_execute) {
        mbResult = { onSuccess: false, onFailure: false, results: [] };
      } else {
        const __results: unknown[] = [];
        for (const __item of mb_items) {
          __results.push((await mb_body_scopeFn(true, __item)).processed);
        }
        mbResult = { onSuccess: true, onFailure: false, results: __results };
      }
      await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.onSuccess);
      await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.onFailure);
      await ctx.setVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, mbResult.results);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('mb', 'mapBranch', mbIdx);
      await __ctrl__.afterNode('mb', ctx);
      mb_success = mbResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapBranch',
        id: 'mb',
        executionIndex: mbIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'mapBranch',
          id: 'mb',
          executionIndex: mbIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, false);
        await ctx.setVariable({ id: 'mb', portName: 'onFailure', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }, true);
        mb_success = false;
      }
      const mhIdx = ctx.addExecution('mh');
      await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, false);
      await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    mb_success = await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }) as boolean;
  }

  if (mb_success) {
    ctx.enterBranch('mb', mbIdx, 'success');
    await __ctrl__.beforeNode('mh', ctx);
    ctx.checkAborted('mh');
    mhIdx = ctx.addExecution('mh');
    if (ctx.shouldExecute('mh', 'mapSink', mhIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'mapSink',
        id: 'mh',
        executionIndex: mhIdx,
        status: 'RUNNING',
      });
      try {
        const mh_execute = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'onSuccess', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }) as boolean : false;
        await ctx.setVariable({ id: 'mh', portName: 'execute', executionIndex: mhIdx, nodeTypeName: 'mapSink', durable: false }, mh_execute);
        const mh_value = mbIdx !== undefined ? await ctx.getVariable({ id: 'mb', portName: 'results', executionIndex: mbIdx, nodeTypeName: 'mapBranch' }) as number : undefined;
        await ctx.setVariable({ id: 'mh', portName: 'value', executionIndex: mhIdx, nodeTypeName: 'mapSink', durable: false }, mh_value);
        const mhResult = mapSink(mh_execute, mh_value);
        await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, mhResult.onSuccess);
        await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, mhResult.onFailure);
        await ctx.setVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, mhResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'mapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('mh', 'mapSink', mhIdx);
        await __ctrl__.afterNode('mh', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'mapSink',
          id: 'mh',
          executionIndex: mhIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'mapSink',
            id: 'mh',
            executionIndex: mhIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('mb', mbIdx, 'failure');
    const mhIdx = ctx.addExecution('mh');
    await ctx.setVariable({ id: 'mh', portName: 'onSuccess', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, false);
    await ctx.setVariable({ id: 'mh', portName: 'onFailure', executionIndex: mhIdx, nodeTypeName: 'mapSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'mapSink',
      id: 'mh',
      executionIndex: mhIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = mhIdx !== undefined ? await ctx.getVariable({ id: 'mh', portName: 'out', executionIndex: mhIdx, nodeTypeName: 'mapSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: neither-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  await __ctrl__.beforeNode('b', ctx);
  ctx.checkAborted('b');
  const bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'br', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });
    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'br', bIdx);
      await __ctrl__.afterNode('b', ctx);
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
      }
      throw error;
    }
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' });
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: node-scoped-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let skIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (scopedFn) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'scopedFn', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'scopedFn',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'scopedFn', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'scopedFn', durable: false }, b_value);
      const b_body_scopeFn = ((ctx) => {
      return (item: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('b', bIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_item = scopedCtx.addExecution('b_param_item');
        scopedCtx.setVariable({ id: 'b', portName: 'item', executionIndex: scopeParamIdx_item, nodeTypeName: 'scopedFn', scope: 'body', side: 'start' }, item);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('b_scope_exit');
        return {  };
      };
    })(ctx);
      const bResult = scopedFn(b_execute, b_value, b_body_scopeFn);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'scopedFn',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'scopedFn', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'scopedFn',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'scopedFn',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'scopedFn' }, true);
        b_success = false;
      }
      const skIdx = ctx.addExecution('sk');
      await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
      await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'nodeScopedSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('sk', ctx);
    ctx.checkAborted('sk');
    skIdx = ctx.addExecution('sk');
    if (ctx.shouldExecute('sk', 'nodeScopedSink', skIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'nodeScopedSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'RUNNING',
      });
      try {
        const sk_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'scopedFn' }) as boolean : false;
        await ctx.setVariable({ id: 'sk', portName: 'execute', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink', durable: false }, sk_execute);
        const sk_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'scopedFn' }) as number : undefined;
        await ctx.setVariable({ id: 'sk', portName: 'value', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink', durable: false }, sk_value);
        const skResult = nodeScopedSink(sk_execute, sk_value);
        await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.onSuccess);
        await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.onFailure);
        await ctx.setVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, skResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'nodeScopedSink',
          id: 'sk',
          executionIndex: skIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('sk', 'nodeScopedSink', skIdx);
        await __ctrl__.afterNode('sk', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'nodeScopedSink',
          id: 'sk',
          executionIndex: skIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'nodeScopedSink',
            id: 'sk',
            executionIndex: skIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const skIdx = ctx.addExecution('sk');
    await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
    await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'nodeScopedSink',
      id: 'sk',
      executionIndex: skIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = skIdx !== undefined ? await ctx.getVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'nodeScopedSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: only-failure-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let failIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (br) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'br', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'br', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, true);
        b_success = false;
      }
      const failIdx = ctx.addExecution('fail');
      await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    const failIdx = ctx.addExecution('fail');
    await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'failSink',
      id: 'fail',
      executionIndex: failIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    await __ctrl__.beforeNode('fail', ctx);
    ctx.checkAborted('fail');
    failIdx = ctx.addExecution('fail');
    if (ctx.shouldExecute('fail', 'failSink', failIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'RUNNING',
      });
      try {
        const fail_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean : false;
        await ctx.setVariable({ id: 'fail', portName: 'execute', executionIndex: failIdx, nodeTypeName: 'failSink', durable: false }, fail_execute);
        const fail_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }) as number : undefined;
        await ctx.setVariable({ id: 'fail', portName: 'value', executionIndex: failIdx, nodeTypeName: 'failSink', durable: false }, fail_value);
        const failResult = failSink(fail_execute, fail_value);
        await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onSuccess);
        await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onFailure);
        await ctx.setVariable({ id: 'fail', portName: 'out', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('fail', 'failSink', failIdx);
        await __ctrl__.afterNode('fail', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'failSink',
            id: 'fail',
            executionIndex: failIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = failIdx !== undefined ? await ctx.getVariable({ id: 'fail', portName: 'out', executionIndex: failIdx, nodeTypeName: 'failSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: only-success-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (br) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'br', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'br', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: regular-branch-scoped-output 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (regScoped) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'regScoped', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'regScoped',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'regScoped', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'regScoped', durable: false }, b_value);
      const b_body_scopeFn = ((ctx) => {
      return (scopedOut: unknown) => {
        // Scope function body for 'body'
    
        // Create scoped context for child nodes
        const scopedCtx = ctx.createScope('b', bIdx!, 'body', true, false);
    
        // Set scope parameters as variables for child nodes
        const scopeParamIdx_scopedOut = scopedCtx.addExecution('b_param_scopedOut');
        scopedCtx.setVariable({ id: 'b', portName: 'scopedOut', executionIndex: scopeParamIdx_scopedOut, nodeTypeName: 'regScoped', scope: 'body', side: 'start' }, scopedOut);
    
        // Merge scoped execution back to parent context
        ctx.mergeScope(scopedCtx);
    
        // Extract return values from child outputs
        const scopeExitIdx = ctx.addExecution('b_scope_exit');
        return {  };
      };
    })(ctx);
      const bResult = regScoped(b_execute, b_value, b_body_scopeFn);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'regScoped' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScoped',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'regScoped', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScoped',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'regScoped',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'regScoped' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScopedSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'regScopedSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'regScopedSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'regScoped' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'regScopedSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'regScoped' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'regScopedSink', durable: false }, ok_value);
        const okResult = regScopedSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'regScopedSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'regScopedSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'regScopedSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'regScopedSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'regScopedSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'regScopedSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: scopes-array-branch 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let skIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (multiScopeFn) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'multiScopeFn', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'multiScopeFn',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'multiScopeFn', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'multiScopeFn', durable: false }, b_value);
      const bResult = multiScopeFn(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'multiScopeFn',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'multiScopeFn', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'multiScopeFn',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'multiScopeFn',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }, true);
        b_success = false;
      }
      const skIdx = ctx.addExecution('sk');
      await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, false);
      await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'multiScopeSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    await __ctrl__.beforeNode('sk', ctx);
    ctx.checkAborted('sk');
    skIdx = ctx.addExecution('sk');
    if (ctx.shouldExecute('sk', 'multiScopeSink', skIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'multiScopeSink',
        id: 'sk',
        executionIndex: skIdx,
        status: 'RUNNING',
      });
      try {
        const sk_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }) as boolean : false;
        await ctx.setVariable({ id: 'sk', portName: 'execute', executionIndex: skIdx, nodeTypeName: 'multiScopeSink', durable: false }, sk_execute);
        const sk_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'multiScopeFn' }) as number : undefined;
        await ctx.setVariable({ id: 'sk', portName: 'value', executionIndex: skIdx, nodeTypeName: 'multiScopeSink', durable: false }, sk_value);
        const skResult = multiScopeSink(sk_execute, sk_value);
        await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, skResult.onSuccess);
        await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, skResult.onFailure);
        await ctx.setVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, skResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'multiScopeSink',
          id: 'sk',
          executionIndex: skIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('sk', 'multiScopeSink', skIdx);
        await __ctrl__.afterNode('sk', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'multiScopeSink',
          id: 'sk',
          executionIndex: skIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'multiScopeSink',
            id: 'sk',
            executionIndex: skIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const skIdx = ctx.addExecution('sk');
    await ctx.setVariable({ id: 'sk', portName: 'onSuccess', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, false);
    await ctx.setVariable({ id: 'sk', portName: 'onFailure', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'multiScopeSink',
      id: 'sk',
      executionIndex: skIdx,
      status: 'CANCELLED',
    });
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = skIdx !== undefined ? await ctx.getVariable({ id: 'sk', portName: 'out', executionIndex: skIdx, nodeTypeName: 'multiScopeSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: single-both-downstream 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let failIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

  // ── b (br) ──
  ctx.checkAborted('b');
  bIdx = ctx.addExecution('b');
  if (ctx.shouldExecute('b', 'br', bIdx)) {
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'br',
      id: 'b',
      executionIndex: bIdx,
      status: 'RUNNING',
    });

    b_success = false;

    try {
      const b_execute = await ctx.getVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }) as boolean;
      await ctx.setVariable({ id: 'b', portName: 'execute', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_execute);
      const b_value = await ctx.getVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }) as number;
      await ctx.setVariable({ id: 'b', portName: 'value', executionIndex: bIdx, nodeTypeName: 'br', durable: false }, b_value);
      const bResult = br(b_execute, b_value);
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onSuccess);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.onFailure);
      await ctx.setVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }, bResult.result);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: 'SUCCEEDED',
      });
      ctx.commitNode('b', 'br', bIdx);
      await __ctrl__.afterNode('b', ctx);
      b_success = bResult.onSuccess;
    } catch (error: unknown) {
      if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'br',
        id: 'b',
        executionIndex: bIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'br',
          id: 'b',
          executionIndex: bIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
        await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }, false);
        await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }, true);
        b_success = false;
      }
      const okIdx = ctx.addExecution('ok');
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'CANCELLED',
      });
      const failIdx = ctx.addExecution('fail');
      await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'CANCELLED',
      });
      throw error;
    }
  } else {
    b_success = await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean;
  }

  if (b_success) {
    ctx.enterBranch('b', bIdx, 'success');
    const failIdx = ctx.addExecution('fail');
    await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'failSink',
      id: 'fail',
      executionIndex: failIdx,
      status: 'CANCELLED',
    });
    await __ctrl__.beforeNode('ok', ctx);
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (ctx.shouldExecute('ok', 'okSink', okIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'okSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'RUNNING',
      });
      try {
        const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean : false;
        await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_execute);
        const ok_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }) as number : undefined;
        await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'okSink', durable: false }, ok_value);
        const okResult = okSink(ok_execute, ok_value);
        await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onSuccess);
        await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.onFailure);
        await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }, okResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('ok', 'okSink', okIdx);
        await __ctrl__.afterNode('ok', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'okSink',
          id: 'ok',
          executionIndex: okIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'okSink',
            id: 'ok',
            executionIndex: okIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  } else {
    ctx.enterBranch('b', bIdx, 'failure');
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'okSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'okSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    await __ctrl__.beforeNode('fail', ctx);
    ctx.checkAborted('fail');
    failIdx = ctx.addExecution('fail');
    if (ctx.shouldExecute('fail', 'failSink', failIdx)) {
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'failSink',
        id: 'fail',
        executionIndex: failIdx,
        status: 'RUNNING',
      });
      try {
        const fail_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'br' }) as boolean : false;
        await ctx.setVariable({ id: 'fail', portName: 'execute', executionIndex: failIdx, nodeTypeName: 'failSink', durable: false }, fail_execute);
        const fail_value = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx, nodeTypeName: 'br' }) as number : undefined;
        await ctx.setVariable({ id: 'fail', portName: 'value', executionIndex: failIdx, nodeTypeName: 'failSink', durable: false }, fail_value);
        const failResult = failSink(fail_execute, fail_value);
        await ctx.setVariable({ id: 'fail', portName: 'onSuccess', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onSuccess);
        await ctx.setVariable({ id: 'fail', portName: 'onFailure', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.onFailure);
        await ctx.setVariable({ id: 'fail', portName: 'out', executionIndex: failIdx, nodeTypeName: 'failSink' }, failResult.out);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: 'SUCCEEDED',
        });
        ctx.commitNode('fail', 'failSink', failIdx);
        await __ctrl__.afterNode('fail', ctx);
      } catch (error: unknown) {
        if ((error as { code?: unknown })?.code === 'FLOW_WEAVER_DURABLE_GATE_YIELD') throw error;
        const isCancellation = CancellationError.isCancellationError(error);
        await ctx.sendStatusChangedEvent({
          nodeTypeName: 'failSink',
          id: 'fail',
          executionIndex: failIdx,
          status: isCancellation ? 'CANCELLED' : 'FAILED',
        });
        if (!isCancellation) {
          ctx.sendLogErrorEvent({
            nodeTypeName: 'failSink',
            id: 'fail',
            executionIndex: failIdx,
            error: error instanceof Error ? error.message : String(error),
            code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
          });
        }
        throw error;
      }
    }
    ctx.exitBranch();
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'okSink' }) : undefined;
  await ctx.setVariable({ id: 'Exit', portName: 'result', executionIndex: exitIdx, nodeTypeName: 'Exit' }, exit_result);

  await ctx.setVariable({ id: 'Exit', portName: 'onSuccess', executionIndex: exitIdx, nodeTypeName: 'Exit' }, true);
  await ctx.setVariable({ id: 'Exit', portName: 'onFailure', executionIndex: exitIdx, nodeTypeName: 'Exit' }, false);
  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;

exports[`branching codegen golden (debt #2) > dev-mode output is stable: workflow-variant-branch-scoped-output 1`] = `
"

// ============================================================================
// Runtime Types
// ============================================================================

type TStatusType =
  | "RUNNING"
  | "SCHEDULED"
  | "SUCCEEDED"
  | "FAILED"
  | "CANCELLED"
  | "PENDING";

type TVariableIdentification = {
  nodeTypeName: string;
  id: string;
  scope?: string | undefined;
  side?: "start" | "exit" | undefined;
  portName: string;
  executionIndex: number;
  key?: string | undefined;
};

type TStatusChangedEvent = {
  type: "STATUS_CHANGED";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  status: TStatusType;
  innerFlowInvocation?: boolean;
};

type TVariableSetEvent = {
  type: "VARIABLE_SET";
  identifier: TVariableIdentification;
  value?: unknown;
  innerFlowInvocation?: boolean;
};

type TErrorLogEvent = {
  type: "LOG_ERROR";
  nodeTypeName: string;
  id: string;
  scope?: string;
  side?: "start" | "exit";
  executionIndex: number;
  error: string;
  code?: string;
  innerFlowInvocation?: boolean;
};

type TWorkflowCompletedEvent = {
  type: "WORKFLOW_COMPLETED";
  executionIndex: number;
  status: "SUCCEEDED" | "FAILED" | "CANCELLED";
  result?: unknown;
  innerFlowInvocation?: boolean;
};

type TEvent =
  | TStatusChangedEvent
  | TVariableSetEvent
  | TErrorLogEvent
  | TWorkflowCompletedEvent;

type TDebugger = {
  sendEvent: (event: TEvent) => void | Promise<void>;
  innerFlowInvocation: boolean;
  sessionId?: string;
};

type TDebugController = {
  beforeNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
  afterNode(nodeId: string, ctx: GeneratedExecutionContext): Promise<void> | void;
};

interface VariableAddress {
  id: string;
  portName: string;
  executionIndex: number;
  nodeTypeName?: string | undefined;
  scope?: string | undefined;
  side?: 'start' | 'exit' | undefined;
  durable?: boolean | undefined;
}

interface ExecutionInfo {
  id: string;
  index: number;
  parentIndex?: number | undefined;
  scopeName?: string | undefined;
}

type DurableGateKind = 'approval' | 'input' | 'agent';
type WireValue = null | boolean | number | string | readonly WireValue[] | { readonly [key: string]: WireValue };
interface WorkflowFrameAddress { workflowId: string; invocation: number; callerNodeId?: string; callerExecutionIndex?: number; }
interface ScopeAddress { parentNodeId: string; parentExecutionIndex: number; scopeName: string; invocation: number; loopIteration?: number; branchArm?: string; }
interface BranchAddress { workflowId: string; frameDepth: number; nodeId: string; executionIndex: number; arm: string; }
interface ExecutionAddress { frames: readonly WorkflowFrameAddress[]; scopes: readonly ScopeAddress[]; branches: readonly BranchAddress[]; nodeId: string; nodeType: string; executionIndex: number; }
interface WorkflowRuntime {
  readonly runId: string;
  readonly abortSignal?: AbortSignal;
  readonly services: { debugger?: TDebugger; debugController?: TDebugController; mocks?: unknown; workflowRegistry?: Readonly<Record<string, (...args: unknown[]) => unknown>>; effectAdapter?: unknown };
  readonly frames: readonly WorkflowFrameAddress[];
  readonly scopes: readonly ScopeAddress[];
  readonly branches: readonly BranchAddress[];
  readonly durable: {
    address(runtime: WorkflowRuntime, nodeId: string, nodeType: string, executionIndex: number): ExecutionAddress;
    shouldExecute(address: ExecutionAddress): boolean;
    commitNode(address: ExecutionAddress): void;
    setVariable(address: ExecutionAddress, portName: string, value: unknown): void;
    getVariable(address: ExecutionAddress, portName: string, allowAncestorLookup?: boolean): unknown;
    resolveGate(runtime: WorkflowRuntime, boundary: { kind: DurableGateKind; nodeId: string; nodeType: string; executionIndex: number; payload: WireValue }): WireValue;
    executeEffect<T extends WireValue>(runtime: WorkflowRuntime, boundary: { nodeId: string; nodeType: string; executionIndex: number }, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T>;
    assertResumeResolutionConsumed(): void;
  };
}

type VariableValue = unknown | (() => unknown) | (() => Promise<unknown>);

// ============================================================================
// Cancellation Error
// ============================================================================

class CancellationError extends Error {
  public readonly executionIndex: number;
  public readonly nodeId?: string;
  public readonly timestamp: number;

  constructor(
    message: string = 'Workflow execution cancelled',
    executionIndex: number = 0,
    nodeId?: string,
    timestamp: number = Date.now()
  ) {
    super(message);
    this.name = 'CancellationError';
    this.executionIndex = executionIndex;
    this.nodeId = nodeId;
    this.timestamp = timestamp;
  }

  static isCancellationError(error: unknown): error is CancellationError {
    return (
      error instanceof CancellationError ||
      (error instanceof Error && error.name === 'CancellationError')
    );
  }
}

// ============================================================================
// Execution Context
// ============================================================================

class GeneratedExecutionContext {
  private variables: Map<string, VariableValue> = new Map();
  private executions: Map<string, ExecutionInfo> = new Map();
  private executionCounter: number = 0;
  private nodeExecutionCounts: Map<string, number> = new Map();
  private isAsync: boolean;
  private flowWeaverDebugger?: TDebugger | undefined;
  private pullExecutors: Map<string, () => void | Promise<void>> = new Map();
  private nodeExecutionIndices: Map<string, number> = new Map();
  private runtime: WorkflowRuntime;
  private scopeInvocationCounts: Map<string, number> = new Map();
  private nestedInvocationCounts: Map<string, number> = new Map();
  private branchStack: BranchAddress[];
  private allowAncestorDurableVariables = true;

  constructor(isAsync: boolean = true, runtime: WorkflowRuntime) {
    this.isAsync = isAsync;
    this.flowWeaverDebugger = runtime.services.debugger;
    this.runtime = runtime;
    this.branchStack = [...runtime.branches];
  }

  registerPullExecutor(id: string, executor: () => void | Promise<void>): void {
    this.pullExecutors.set(id, executor);
  }

  addExecution(id: string, parentIndex?: number, scopeName?: string): number {
    // Use per-node execution counter (each node starts at 0)
    const currentCount = this.nodeExecutionCounts.get(id) || 0;
    const index = currentCount;
    this.nodeExecutionCounts.set(id, currentCount + 1);
    this.executionCounter++;
    this.executions.set(this.getExecutionKey(id, index), {
      id,
      index,
      parentIndex,
      scopeName,
    });
    this.nodeExecutionIndices.set(id, index);
    return index;
  }

  setVariable(address: VariableAddress, value: VariableValue): void | Promise<void> {
    const key = this.getVariableKey(address);
    this.variables.set(key, value);
    if (typeof value !== "function" && address.durable !== false) {
      this.runtime.durable.setVariable(this.executionAddress(address), address.portName, value);
    }
    if (this.flowWeaverDebugger) {
      const actualValue = typeof value === "function" ? value() : value;
      this.sendVariableSetEvent({
        identifier: {
          nodeTypeName: address.nodeTypeName || "unknown",
          id: address.id,
          portName: address.portName,
          executionIndex: address.executionIndex,
          key: "default",
          ...(address.scope && { scope: address.scope }),
          ...(address.side && { side: address.side }),
        },
        value: actualValue,
      });
    }
    return this.isAsync ? Promise.resolve() : undefined;
  }

  getVariable(address: VariableAddress): unknown | Promise<unknown> {
    const executor = this.pullExecutors.get(address.id);
    if (executor) {
      if (!this.hasVariable(address)) {
        const result = executor();
        // Handle async executor (returns Promise)
        if (result instanceof Promise) {
          return result.then(() => {
            const trackedIndex = this.nodeExecutionIndices.get(address.id);
            const finalAddress = trackedIndex !== undefined
              ? { ...address, executionIndex: trackedIndex }
              : address;
            return this.retrieveVariable(finalAddress);
          });
        }
        // Handle sync executor (returns void)
        const trackedIndex = this.nodeExecutionIndices.get(address.id);
        const finalAddress = trackedIndex !== undefined
          ? { ...address, executionIndex: trackedIndex }
          : address;
        return this.retrieveVariable(finalAddress);
      }
    }
    return this.retrieveVariable(address);
  }

  private retrieveVariable(address: VariableAddress): unknown | Promise<unknown> {
    const key = this.getVariableKey(address);
    let value = this.variables.get(key);
    if (!this.variables.has(key)) {
      value = this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables);
      if (value === undefined) {
        throw new Error(\`Variable not found: \${address.id}.\${address.portName}[\${address.executionIndex}]\`);
      }
      this.variables.set(key, value);
    }
    if (typeof value === "function") {
      const result = value();
      if (result instanceof Promise) {
        return result;
      }
      return this.isAsync ? Promise.resolve(result) : result;
    }
    return this.isAsync ? Promise.resolve(value) : value;
  }

  hasVariable(address: VariableAddress): boolean {
    const key = this.getVariableKey(address);
    return this.variables.has(key) || this.runtime.durable.getVariable(this.executionAddress(address), address.portName, this.allowAncestorDurableVariables) !== undefined;
  }

  executionAddress(address: Pick<VariableAddress, "id" | "executionIndex" | "nodeTypeName">): ExecutionAddress {
    const runtime = this.getRuntime();
    return runtime.durable.address(runtime, address.id, address.nodeTypeName ?? address.id, address.executionIndex);
  }

  shouldExecute(nodeId: string, nodeType: string, executionIndex: number): boolean {
    const runtime = this.getRuntime();
    return runtime.durable.shouldExecute(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  commitNode(nodeId: string, nodeType: string, executionIndex: number): void {
    const runtime = this.getRuntime();
    runtime.durable.commitNode(runtime.durable.address(runtime, nodeId, nodeType, executionIndex));
  }

  resolveGate(kind: DurableGateKind, nodeId: string, nodeType: string, executionIndex: number, payload: WireValue): WireValue {
    const runtime = this.getRuntime();
    return runtime.durable.resolveGate(runtime, { kind, nodeId, nodeType, executionIndex, payload });
  }

  executeEffect<T extends WireValue>(nodeId: string, nodeType: string, executionIndex: number, execute: (operationKey: string) => Promise<{ result: T; receipt: WireValue }>): Promise<T> {
    const runtime = this.getRuntime();
    return runtime.durable.executeEffect(runtime, { nodeId, nodeType, executionIndex }, execute);
  }

  createNestedRuntime(workflowId: string, callerNodeId: string, callerExecutionIndex: number): WorkflowRuntime {
    const invocation = this.nestedInvocationCounts.get(callerNodeId) ?? 0;
    this.nestedInvocationCounts.set(callerNodeId, invocation + 1);
    const parentRuntime = this.getRuntime();
    return { ...parentRuntime, frames: [...parentRuntime.frames, { workflowId, invocation, callerNodeId, callerExecutionIndex }], scopes: parentRuntime.scopes };
  }

  enterBranch(nodeId: string, executionIndex: number, arm: string): void { const frameDepth = this.runtime.frames.length - 1; const workflowId = this.runtime.frames[frameDepth].workflowId; this.branchStack.push({ workflowId, frameDepth, nodeId, executionIndex, arm }); }
  exitBranch(): void { this.branchStack.pop(); }
  getRuntime(): WorkflowRuntime { return { ...this.runtime, branches: [...this.branchStack] }; }
  forkParallel(): GeneratedExecutionContext {
    const parallelContext = new GeneratedExecutionContext(this.isAsync, this.getRuntime());
    parallelContext.variables = new Map(this.variables);
    parallelContext.executions = new Map(this.executions);
    parallelContext.executionCounter = this.executionCounter;
    parallelContext.pullExecutors = new Map(this.pullExecutors);
    parallelContext.nodeExecutionIndices = new Map(this.nodeExecutionIndices);
    parallelContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    parallelContext.scopeInvocationCounts = new Map(this.scopeInvocationCounts);
    parallelContext.nestedInvocationCounts = new Map(this.nestedInvocationCounts);
    parallelContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables;
    return parallelContext;
  }
  mergeParallel(parallelContext: GeneratedExecutionContext): void {
    this.mergeScope(parallelContext);
    parallelContext.nodeExecutionIndices.forEach((index, id) => { this.nodeExecutionIndices.set(id, index); });
    parallelContext.scopeInvocationCounts.forEach((count, key) => { this.scopeInvocationCounts.set(key, Math.max(this.scopeInvocationCounts.get(key) ?? 0, count)); });
    parallelContext.nestedInvocationCounts.forEach((count, key) => { this.nestedInvocationCounts.set(key, Math.max(this.nestedInvocationCounts.get(key) ?? 0, count)); });
  }

  getExecution(id: string, index: number): ExecutionInfo | undefined {
    return this.executions.get(this.getExecutionKey(id, index));
  }

  createScope(_parentNodeName: string, _parentIndex: number, _scopeName: string, cleanScope: boolean = false, isAsyncOverride?: boolean): GeneratedExecutionContext {
    const effectiveIsAsync = isAsyncOverride !== undefined ? isAsyncOverride : this.isAsync;
    const scopeKey = \`\${_parentNodeName}:\${_parentIndex}:\${_scopeName}\`;
    const scopeInvocation = this.scopeInvocationCounts.get(scopeKey) ?? 0;
    this.scopeInvocationCounts.set(scopeKey, scopeInvocation + 1);
    const parentRuntime = this.getRuntime();
    const scopedRuntime: WorkflowRuntime = { ...parentRuntime, scopes: [...parentRuntime.scopes, { parentNodeId: _parentNodeName, parentExecutionIndex: _parentIndex, scopeName: _scopeName, invocation: scopeInvocation, loopIteration: scopeInvocation }] };
    const scopedContext = new GeneratedExecutionContext(effectiveIsAsync, scopedRuntime);
    // For per-port function scopes (cleanScope=true), start with empty variables
    // For node-level scopes (cleanScope=false), inherit parent variables
    scopedContext.variables = cleanScope ? new Map() : new Map(this.variables);
    scopedContext.allowAncestorDurableVariables = this.allowAncestorDurableVariables && !cleanScope;
    scopedContext.executions = new Map(this.executions);
    scopedContext.executionCounter = this.executionCounter;
    scopedContext.nodeExecutionCounts = new Map(this.nodeExecutionCounts);
    return scopedContext;
  }

  mergeScope(scopedContext: GeneratedExecutionContext): void {
    scopedContext.executions.forEach((info, key) => {
      this.executions.set(key, info);
    });
    scopedContext.variables.forEach((value, key) => {
      this.variables.set(key, value);
    });
    this.executionCounter = Math.max(this.executionCounter, scopedContext.executionCounter);
    scopedContext.nodeExecutionCounts.forEach((count, id) => {
      const currentCount = this.nodeExecutionCounts.get(id) || 0;
      this.nodeExecutionCounts.set(id, Math.max(currentCount, count));
    });
  }

  private getVariableKey(address: VariableAddress): string {
    return \`\${address.id}:\${address.portName}:\${address.executionIndex}\`;
  }

  private getExecutionKey(id: string, index: number): string {
    return \`\${id}:\${index}\`;
  }

  getExecutionCount(): number {
    return this.executionCounter;
  }

  reset(): void {
    this.variables.clear();
    this.executions.clear();
    this.executionCounter = 0;
    this.nodeExecutionCounts.clear();
  }

  isAborted(): boolean {
    return this.runtime.abortSignal?.aborted ?? false;
  }

  getAbortSignal(): AbortSignal | undefined {
    return this.runtime.abortSignal;
  }

  checkAborted(nodeId?: string): void {
    if (this.runtime.abortSignal?.aborted) {
      throw new CancellationError(
        \`Workflow execution cancelled\${nodeId ? \` at \${nodeId}\` : ''}\`,
        this.executionCounter,
        nodeId
      );
    }
  }

  async sendStatusChangedEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    status: TStatusType;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "STATUS_CHANGED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  private async sendVariableSetEvent(args: {
    identifier: TVariableIdentification;
    value: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "VARIABLE_SET",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendLogErrorEvent(args: {
    nodeTypeName: string;
    id: string;
    scope?: string;
    side?: "start" | "exit";
    executionIndex: number;
    error: string;
    code?: string;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "LOG_ERROR",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  async sendWorkflowCompletedEvent(args: {
    executionIndex: number;
    status: "SUCCEEDED" | "FAILED" | "CANCELLED";
    result?: unknown;
  }): Promise<void> {
    if (this.flowWeaverDebugger) {
      await this.flowWeaverDebugger.sendEvent({
        type: "WORKFLOW_COMPLETED",
        ...args,
        innerFlowInvocation: this.flowWeaverDebugger.innerFlowInvocation,
      });
    }
  }

  inspectVariables(): Record<string, unknown> {
    const vars: Record<string, unknown> = {};
    for (const [key, value] of this.variables) {
      vars[key] = typeof value === "function" ? "[lazy value]" : value;
    }
    return vars;
  }
}





export async function testWorkflow(
  execute: boolean = true,
  params: Record<string, unknown> = {},
  __runtime__: WorkflowRuntime
): Promise<{ onSuccess: boolean; onFailure: boolean; result: number }> {
  // Recursion depth protection
  const __rd__ = (params as { __rd__?: number }).__rd__ ?? 0;
  if (__rd__ >= 1000) {
    throw new Error('Max recursion depth exceeded (1000) in workflow "testWorkflow"');
  }

  const ctx = new GeneratedExecutionContext(true, __runtime__);

  const __ctrl__: TDebugController = (__runtime__.services.debugController ?? { beforeNode: () => {}, afterNode: () => {} }) as TDebugController;

  const startIdx = ctx.addExecution('Start');
  if (ctx.shouldExecute('Start', 'Start', startIdx)) {
    await ctx.setVariable({ id: 'Start', portName: 'execute', executionIndex: startIdx, nodeTypeName: 'Start' }, execute);
    await ctx.setVariable({ id: 'Start', portName: 'n', executionIndex: startIdx, nodeTypeName: 'Start' }, params.n);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'Start',
      id: 'Start',
      executionIndex: startIdx,
      status: 'SUCCEEDED',
    });
    ctx.commitNode('Start', 'Start', startIdx);
  }

  let bIdx: number | undefined;
  let okIdx: number | undefined;
  let b_success = false;

  await __ctrl__.beforeNode('b', ctx);

