    const isCancellation = CancellationError.isCancellationError(error);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'subWf',
      id: 'b',
      executionIndex: bIdx,
      status: isCancellation ? 'CANCELLED' : 'FAILED',
    });
    if (!isCancellation) {
      ctx.sendLogErrorEvent({
        nodeTypeName: 'subWf',
        id: 'b',
        executionIndex: bIdx,
        error: error instanceof Error ? error.message : String(error),
        code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
      });
      await ctx.setVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx, nodeTypeName: 'subWf' }, false);
      await ctx.setVariable({ id: 'b', portName: 'onFailure', executionIndex: bIdx, nodeTypeName: 'subWf' }, true);
      b_success = false;
    }
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'subWfSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
    throw error;
  }

  if (b_success) {
    ctx.checkAborted('ok');
    okIdx = ctx.addExecution('ok');
    if (typeof globalThis !== 'undefined') (globalThis as unknown as { __fw_current_node_id__?: string }).__fw_current_node_id__ = 'ok';
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'subWfSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'RUNNING',
    });
    try {
      const ok_execute = bIdx !== undefined ? await ctx.getVariable({ id: 'b', portName: 'onSuccess', executionIndex: bIdx }) as boolean : false;
      await ctx.setVariable({ id: 'ok', portName: 'execute', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, ok_execute);
      const ok_value = await ctx.getVariable({ id: 'b', portName: 'result', executionIndex: bIdx! }) as number;
      await ctx.setVariable({ id: 'ok', portName: 'value', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, ok_value);
      const okResult = subWfSink(ok_execute, ok_value);
      await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, okResult.onSuccess);
      await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, okResult.onFailure);
      await ctx.setVariable({ id: 'ok', portName: 'out', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, okResult.out);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'subWfSink',
        id: 'ok',
        executionIndex: okIdx,
        status: 'SUCCEEDED',
      });
    } catch (error: unknown) {
      const isCancellation = CancellationError.isCancellationError(error);
      await ctx.sendStatusChangedEvent({
        nodeTypeName: 'subWfSink',
        id: 'ok',
        executionIndex: okIdx,
        status: isCancellation ? 'CANCELLED' : 'FAILED',
      });
      if (!isCancellation) {
        ctx.sendLogErrorEvent({
          nodeTypeName: 'subWfSink',
          id: 'ok',
          executionIndex: okIdx,
          error: error instanceof Error ? error.message : String(error),
          code: typeof (error as { code?: unknown }).code === 'string' ? ((error as { code?: unknown }).code as string) : undefined,
        });
      }
      throw error;
    }
  } else {
    const okIdx = ctx.addExecution('ok');
    await ctx.setVariable({ id: 'ok', portName: 'onSuccess', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
    await ctx.setVariable({ id: 'ok', portName: 'onFailure', executionIndex: okIdx, nodeTypeName: 'subWfSink' }, false);
    await ctx.sendStatusChangedEvent({
      nodeTypeName: 'subWfSink',
      id: 'ok',
      executionIndex: okIdx,
      status: 'CANCELLED',
    });
  }
  ctx.checkAborted('Exit');
  const exitIdx = ctx.addExecution('Exit');
  const exit_result = okIdx !== undefined ? await ctx.getVariable({ id: 'ok', portName: 'out', executionIndex: okIdx }) : undefined;

  const finalResult = { onSuccess: true, onFailure: false, result: exit_result as number };

  await ctx.sendStatusChangedEvent({
    nodeTypeName: 'Exit',
    id: 'Exit',
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
  });
  ctx.sendWorkflowCompletedEvent({
    executionIndex: exitIdx,
    status: 'SUCCEEDED',
    result: finalResult,
  });

  return finalResult;
}"
`;
