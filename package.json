{
  "name": "@synergenius/flow-weaver",
  "version": "0.38.0",
  "description": "Flow Weaver: deterministic TypeScript workflow compiler. Define workflows with JSDoc annotations, compile to standalone functions with zero runtime dependencies.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./built-in-nodes": {
      "types": "./dist/built-in-nodes/index.d.ts",
      "default": "./dist/built-in-nodes/index.js"
    },
    "./diagram": {
      "types": "./dist/diagram/index.d.ts",
      "default": "./dist/diagram/index.js"
    },
    "./describe": {
      "types": "./dist/cli/commands/describe.d.ts",
      "default": "./dist/cli/commands/describe.js"
    },
    "./doc-metadata": {
      "types": "./dist/doc-metadata/index.d.ts",
      "default": "./dist/doc-metadata/index.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "default": "./dist/docs/index.js"
    },
    "./ast": {
      "types": "./dist/ast/index.d.ts",
      "default": "./dist/ast/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./diff": {
      "types": "./dist/diff/index.d.ts",
      "default": "./dist/diff/index.js"
    },
    "./editor": {
      "types": "./dist/editor-completions/index.d.ts",
      "default": "./dist/editor-completions/index.js"
    },
    "./browser": {
      "types": "./dist/jsdoc-port-sync/index.d.ts",
      "default": "./dist/jsdoc-port-sync/index.js"
    },
    "./generated-branding": {
      "types": "./dist/generated-branding.d.ts",
      "default": "./dist/generated-branding.js"
    },
    "./npm-packages": {
      "types": "./dist/npm-packages.d.ts",
      "default": "./dist/npm-packages.js"
    },
    "./deployment": {
      "types": "./dist/deployment/index.d.ts",
      "default": "./dist/deployment/index.js"
    },
    "./marketplace": {
      "types": "./dist/marketplace/index.d.ts",
      "default": "./dist/marketplace/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "default": "./dist/generator/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./cli": {
      "types": "./dist/cli/exports.d.ts",
      "default": "./dist/cli/exports.js"
    },
    "./version": {
      "types": "./dist/generated-version.d.ts",
      "default": "./dist/generated-version.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./dist/context/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./console": {
      "types": "./dist/console/index.d.ts",
      "default": "./dist/console/index.js"
    },
    "./coordinator": {
      "types": "./dist/coordinator/index.d.ts",
      "default": "./dist/coordinator/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "bin": {
    "flow-weaver": "./dist/cli/flow-weaver.mjs",
    "fw": "./dist/cli/flow-weaver.mjs"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs/reference",
    "scripts/postinstall.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "tsx scripts/generate-version.ts && tsx scripts/generate-built-in-registry.ts",
    "generate:registry": "tsx scripts/generate-built-in-registry.ts",
    "generate:registry:check": "tsx scripts/generate-built-in-registry.ts --check",
    "build": "rimraf dist .tsbuildinfo && tsc -p tsconfig.build.json && npm run build:cli && npm run build:console",
    "postbuild": "npx tsx scripts/postbuild.ts && npm run generate:docs",
    "generate:docs": "tsx scripts/generate-docs.ts",
    "generate:docs:check": "tsx scripts/generate-docs.ts --check",
    "release": "tsx scripts/release.ts",
    "build:cli": "npx tsx scripts/build-cli.ts",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput --incremental",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "lint": "npx eslint src",
    "lint:fix": "npx eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "docs": "typedoc && tsx scripts/generate-grammar-docs.ts",
    "docs:serve": "npm run docs && npx http-server docs/api -c-1 -o",
    "prepare": "npm run build && husky || true",
    "cli": "tsx src/cli/index.ts",
    "diagram": "tsx scripts/generate-diagram.ts",
    "postinstall": "node scripts/postinstall.cjs",
    "build:console": "npx tsx scripts/build-console.ts",
    "typecheck:console": "tsc --noEmit -p console-ui/tsconfig.json"
  },
  "keywords": [
    "flow-weaver",
    "workflow",
    "workflow-engine",
    "workflow-automation",
    "orchestration",
    "ai-agent",
    "llm",
    "mcp",
    "typescript",
    "compiler",
    "code-generation",
    "visual-programming",
    "node-graph",
    "durable-execution",
    "inngest",
    "serverless"
  ],
  "author": "Ricardo José Horta Morais",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://flowweaver.ai",
  "bugs": "https://github.com/synergenius-fw/flow-weaver/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/synergenius-fw/flow-weaver.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@inquirer/confirm": "^6.1.1",
    "@inquirer/core": "^11.2.1",
    "@inquirer/input": "^5.1.1",
    "@inquirer/select": "^5.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chevrotain": "^12.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "immer": "^11.1.8",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "source-map": "^0.7.6",
    "ts-morph": "^28.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@preact/signals": "^2.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "husky": "^9.1.7",
    "marked": "^18.0.13",
    "preact": "^10.29.0",
    "prettier": "^3.8.3",
    "rimraf": "6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
